<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Catalogo unico dei permessi (PIANO-PERMESSI-REBUILD.md §12): embedded così il
       binario e il catalogo non possono divergere nel deploy differenziale. -->
  <ItemGroup>
    <EmbeddedResource Include="catalogo-permessi.json" />
  </ItemGroup>
</Project>
