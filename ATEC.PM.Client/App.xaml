<Application
    x:Class="ATEC.PM.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Startup="App_Startup">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AtecColors.xaml" />
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Resources/MoMResources.xaml" />
                <ResourceDictionary Source="/Resources/GridStyles.xaml" />
                <ResourceDictionary Source="/Resources/Converters.xaml" />
                <ResourceDictionary Source="/Resources/ExpanderStyles.xaml" />
                <ResourceDictionary Source="/Resources/TreeviewStyles.xaml" />
                <ResourceDictionary Source="/Resources/ComboStyles.xaml" />
                <ResourceDictionary Source="/Resources/TextBlockStyles.xaml" />
                <ResourceDictionary Source="/Resources/ToggleSwitchStyle.xaml" />
                <ResourceDictionary Source="/Themes/Generic.xaml" />
                <!--
                    Shadcn UI: mergeato globalmente (ultimo = gli stili impliciti Shadcn
                    prevalgono sui vecchi globali). I merge locali nelle pagine sono ora ridondanti.
                -->
                <ResourceDictionary Source="/Styles/Shadcn/ShadcnTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>


</Application>
