<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ATEC.PM.Client.Controls">

    <!--
        ═══════════════════════════════════════════════════════════
        Shared Styles
        ═══════════════════════════════════════════════════════════
    -->

    <Style x:Key="CC_ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F9FAFB" />
        <Setter Property="Foreground" Value="#6B7280" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <Style x:Key="CC_Cell" TargetType="DataGridCell">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CC_ChevronPath" TargetType="Path">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="M 0,0 L 4.5,4.5 L 0,9" />
        <Setter Property="Stroke" Value="#9CA3AF" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <!--
        ═══════════════════════════════════════════════════════════
        KpiCard Custom Control Style
        ═══════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type controls:KpiCard}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E4E4E7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />

        <!--  Default Font Family (fallback to Inter if loaded, else System)  -->
        <Setter Property="TitleFontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="ValueFontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="BadgeFontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="TrendFontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="SubtitleFontFamily" Value="{DynamicResource ShadcnFontFamily}" />

        <!--  Default Colors for Light Theme  -->
        <Setter Property="TitleForeground" Value="#71717A" />
        <Setter Property="ValueForeground" Value="#09090B" />
        <Setter Property="BadgeForeground" Value="#71717A" />
        <Setter Property="BadgeBackground" Value="#F4F4F5" />
        <Setter Property="TrendForeground" Value="#09090B" />
        <Setter Property="SubtitleForeground" Value="#71717A" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:KpiCard}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Top Row: Title and Badge  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding TitleFontFamily}"
                                    FontSize="{TemplateBinding TitleFontSize}"
                                    FontWeight="{TemplateBinding TitleFontWeight}"
                                    Foreground="{TemplateBinding TitleForeground}"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    x:Name="brdBadge"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="8,3,8,3"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding BadgeBackground}"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            x:Name="badgeIcon"
                                            Width="9"
                                            Height="9"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Stroke="{TemplateBinding BadgeForeground}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.5"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{TemplateBinding BadgeFontFamily}"
                                            FontSize="{TemplateBinding BadgeFontSize}"
                                            FontWeight="{TemplateBinding BadgeFontWeight}"
                                            Foreground="{TemplateBinding BadgeForeground}"
                                            Text="{TemplateBinding BadgeText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Middle Row: Large Value  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                FontFamily="{TemplateBinding ValueFontFamily}"
                                FontSize="{TemplateBinding ValueFontSize}"
                                FontWeight="{TemplateBinding ValueFontWeight}"
                                Foreground="{TemplateBinding ValueForeground}"
                                Text="{TemplateBinding Value}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Bottom Row: Trend and Subtitle  -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,16,0,0"
                                VerticalAlignment="Bottom">
                                <StackPanel
                                    x:Name="pnlTrend"
                                    Margin="0,0,0,2"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding TrendFontFamily}"
                                        FontSize="{TemplateBinding TrendFontSize}"
                                        FontWeight="{TemplateBinding TrendFontWeight}"
                                        Foreground="{TemplateBinding TrendForeground}"
                                        Text="{TemplateBinding TrendText}" />
                                    <Path
                                        x:Name="trendIcon"
                                        Width="10"
                                        Height="10"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Stroke="{TemplateBinding TrendForeground}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.5"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="txtSubtitle"
                                    FontFamily="{TemplateBinding SubtitleFontFamily}"
                                    FontSize="{TemplateBinding SubtitleFontSize}"
                                    FontWeight="{TemplateBinding SubtitleFontWeight}"
                                    Foreground="{TemplateBinding SubtitleForeground}"
                                    Text="{TemplateBinding Subtitle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Control Template Triggers for Trend, Theme and Spacing  -->
                    <ControlTemplate.Triggers>
                        <!--  Visibility triggers for Badge, Trend and Subtitle  -->
                        <Trigger Property="BadgeText" Value="">
                            <Setter TargetName="brdBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="BadgeText" Value="{x:Null}">
                            <Setter TargetName="brdBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="TrendText" Value="">
                            <Setter TargetName="pnlTrend" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="TrendText" Value="{x:Null}">
                            <Setter TargetName="pnlTrend" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="txtSubtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="txtSubtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Trend: Up  -->
                        <Trigger Property="Trend" Value="Up">
                            <Setter TargetName="badgeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="badgeIcon" Property="Data" Value="M 1,8 L 8,1 M 3.5,1 L 8,1 L 8,5.5" />
                            <Setter TargetName="trendIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="trendIcon" Property="Data" Value="M 1,9 L 9,1 M 4,1 L 9,1 L 9,6" />
                        </Trigger>

                        <!--  Trend: Down  -->
                        <Trigger Property="Trend" Value="Down">
                            <Setter TargetName="badgeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="badgeIcon" Property="Data" Value="M 1,1 L 8,8 M 3.5,8 L 8,8 L 8,3.5" />
                            <Setter TargetName="trendIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="trendIcon" Property="Data" Value="M 1,1 L 9,9 M 4,9 L 9,9 L 9,4" />
                        </Trigger>

                        <!--  Trend: Flat  -->
                        <Trigger Property="Trend" Value="Flat">
                            <Setter TargetName="badgeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="badgeIcon" Property="Data" Value="M 1,4.5 L 8,4.5 M 5,1.5 L 8,4.5 L 5,7.5" />
                            <Setter TargetName="trendIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="trendIcon" Property="Data" Value="M 1,5 L 9,5 M 6,2 L 9,5 L 6,8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Style Triggers for Themes & Semantic Colors  -->
        <Style.Triggers>
            <!--
                ====================================================
                DARK THEME OVERRIDES
                ====================================================
            -->
            <Trigger Property="Theme" Value="Dark">
                <Setter Property="Background" Value="#18181B" />
                <Setter Property="BorderBrush" Value="#27272A" />
                <Setter Property="TitleForeground" Value="#9CA3AF" />
                <Setter Property="ValueForeground" Value="White" />
                <Setter Property="BadgeForeground" Value="White" />
                <Setter Property="BadgeBackground" Value="#27272A" />
                <Setter Property="TrendForeground" Value="White" />
                <Setter Property="SubtitleForeground" Value="#71717A" />
            </Trigger>

            <!--
                ====================================================
                LIGHT THEME STATUS COLORS
                ====================================================
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Theme" Value="Light" />
                    <Condition Property="Trend" Value="Up" />
                </MultiTrigger.Conditions>
                <Setter Property="BadgeForeground" Value="#10B981" />
                <Setter Property="BadgeBackground" Value="#E6F7ED" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Theme" Value="Light" />
                    <Condition Property="Trend" Value="Down" />
                </MultiTrigger.Conditions>
                <Setter Property="BadgeForeground" Value="#EF4444" />
                <Setter Property="BadgeBackground" Value="#FEE2E2" />
            </MultiTrigger>

            <!--
                ====================================================
                DARK THEME STATUS COLORS
                ====================================================
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Theme" Value="Dark" />
                    <Condition Property="Trend" Value="Up" />
                </MultiTrigger.Conditions>
                <Setter Property="BadgeForeground" Value="#34D399" />
                <Setter Property="BadgeBackground" Value="#1B3629" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Theme" Value="Dark" />
                    <Condition Property="Trend" Value="Down" />
                </MultiTrigger.Conditions>
                <Setter Property="BadgeForeground" Value="#F87171" />
                <Setter Property="BadgeBackground" Value="#3F1E1E" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

