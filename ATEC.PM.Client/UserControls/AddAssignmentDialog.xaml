<Window
    x:Class="ATEC.PM.Client.UserControls.AddAssignmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Assegna Tecnico"
    Width="360"
    MinHeight="200"
    Background="#F7F8FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!--  Footer  -->
        <Border
            Padding="16,12"
            Background="White"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <TextBlock
                    x:Name="txtError"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShadcnSmall}"
                    Foreground="#EF4444" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Height="32"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonOutline}" />
                    <Button
                        Width="80"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="BtnAdd_Click"
                        Content="Aggiungi"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Form  -->
        <StackPanel Margin="20,16">

            <TextBlock
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="TECNICO *" />
            <ComboBox
                x:Name="cmbEmployee"
                Height="32"
                Margin="0,4,0,0"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"
                Style="{StaticResource ShadcnComboBox}" />

            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="ORE PIANIFICATE *" />
            <TextBox
                x:Name="txtHours"
                Height="32"
                Margin="0,4,0,0"
                Style="{StaticResource ShadcnTextBox}"
                Text="0" />

            <CheckBox
                x:Name="chkAllPhases"
                Margin="0,16,0,0"
                Content="Assegna a tutte le fasi della sezione"
                Style="{StaticResource ShadcnCheckBox}" />

        </StackPanel>
    </DockPanel>
</Window>
