<UserControl x:Class="ATEC.PM.Client.Controls.ShadcnDataTableShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <DockPanel Background="{DynamicResource ShadcnBackgroundBrush}">

        <!-- TOOLBAR (slot sinistra + destra) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ShadcnCardBrush}"
                BorderBrush="{DynamicResource ShadcnBorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="{Binding ToolbarRight, ElementName=Root}" />
                <ContentPresenter VerticalAlignment="Center"
                                  Content="{Binding ToolbarLeft, ElementName=Root}" />
            </DockPanel>
        </Border>

        <!-- BARRA DI STATO / PAGINAZIONE -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ShadcnCardBrush}"
                BorderBrush="{DynamicResource ShadcnBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <TextBlock Text="{Binding StatusText, ElementName=Root}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Hint testuale (zero larghezza se vuoto) -->
                    <TextBlock Text="{Binding Hint, ElementName=Root}"
                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource ShadcnMutedForegroundBrush}" />
                    <!-- Slot paginazione (vuoto se non impostato) -->
                    <ContentPresenter VerticalAlignment="Center"
                                      Content="{Binding Pagination, ElementName=Root}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- AREA CENTRALE: la DataGrid fornita dalla pagina -->
        <ContentPresenter Content="{Binding Body, ElementName=Root}" />
    </DockPanel>
</UserControl>
