<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Dependencies  -->
    <!--  Requires ShadcnColors.xaml to be merged before this dictionary  -->

    <!--  Base Typography Style  -->
    <Style x:Key="ShadcnTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!--  Headings  -->
    <Style
        x:Key="ShadcnH1"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style
        x:Key="ShadcnH2"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style
        x:Key="ShadcnH3"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="ShadcnH4"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Standard Paragraph  -->
    <Style
        x:Key="ShadcnP"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>

    <!--  Lead Text  -->
    <Style
        x:Key="ShadcnLead"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
    </Style>

    <!--  Large / Accent Text  -->
    <Style
        x:Key="ShadcnLarge"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Small text  -->
    <Style
        x:Key="ShadcnSmall"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!--  Muted Text (e.g. details, footnotes)  -->
    <Style
        x:Key="ShadcnMuted"
        BasedOn="{StaticResource ShadcnTextBase}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>

</ResourceDictionary>
