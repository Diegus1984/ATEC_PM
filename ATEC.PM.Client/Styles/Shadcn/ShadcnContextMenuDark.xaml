<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ===================================================================
        SHADCN — CONTEXT MENU (DARK / POPOVER)
        ===================================================================
        Menu contestuale a tema scuro, coerente col menu profilo/logout della
        sidebar (MainWindow). Palette autosufficiente (i brush Sidebar* del menu
        profilo sono locali a MainWindow.xaml e NON raggiungibili dalle pagine):
        qui sono replicati come ShadcnMenuDark* per poterli riusare ovunque.

        Uso (in pagina):
          <ContextMenu Style="{StaticResource ShadcnContextMenuDark}">
            <ContextMenu.Resources>
              <Style TargetType="MenuItem"  BasedOn="{StaticResource ShadcnMenuItemDark}" />
              <Style TargetType="Separator" BasedOn="{StaticResource ShadcnMenuSeparatorDark}" />
            </ContextMenu.Resources>
            ...
          </ContextMenu>
    -->

    <!--  Palette (allineata al menu profilo: bg #09090B, hover #18181B, ecc.)  -->
    <SolidColorBrush x:Key="ShadcnMenuDarkBgBrush" Color="#09090B" />
    <SolidColorBrush x:Key="ShadcnMenuDarkBorderBrush" Color="#1F1F23" />
    <SolidColorBrush x:Key="ShadcnMenuDarkTextBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="ShadcnMenuDarkTextHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ShadcnMenuDarkHoverBgBrush" Color="#18181B" />
    <SolidColorBrush x:Key="ShadcnMenuDarkMutedBrush" Color="#71717A" />
    <SolidColorBrush x:Key="ShadcnMenuDarkDisabledBrush" Color="#4B4B52" />

    <!--  ContextMenu (popover scuro con angoli arrotondati + ombra)  -->
    <Style x:Key="ShadcnContextMenuDark" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ShadcnMenuDarkBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnMenuDarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.3"
                                ShadowDepth="3"
                                Color="Black" />
                        </Border.Effect>
                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  MenuItem (voci flat: Header a sinistra, scorciatoia a destra)  -->
    <Style x:Key="ShadcnMenuItemDark" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMenuDarkTextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="bd"
                        Margin="4,1"
                        Background="Transparent"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIconGroup" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Icona (glifo monocromatico via MenuItem.Icon); eredita il Foreground
                                della voce, quindi diventa bianca in hover come il testo.
                            -->
                            <ContentPresenter
                                Grid.Column="0"
                                Margin="10,0,8,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Icon" />

                            <!--  Testo  -->
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />

                            <!--  Scorciatoia (F2, Ctrl+X, ...) — resta sempre muted  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource ShadcnMenuDarkMutedBrush}"
                                Text="{TemplateBinding InputGestureText}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShadcnMenuDarkHoverBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ShadcnMenuDarkTextHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ShadcnMenuDarkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Separator scuro  -->
    <Style x:Key="ShadcnMenuSeparatorDark" TargetType="Separator">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border
                        Height="1"
                        Background="{DynamicResource ShadcnMenuDarkBorderBrush}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
