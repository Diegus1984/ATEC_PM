<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ===================================================================
        SHADCN UI - DESIGN SYSTEM COLORS (LIGHT THEME DEFAULT)
        ===================================================================
    -->

    <!--  Base Palette  -->
    <Color x:Key="ShadcnBackground">#FFFFFF</Color>
    <Color x:Key="ShadcnForeground">#09090B</Color>

    <Color x:Key="ShadcnCard">#FFFFFF</Color>
    <Color x:Key="ShadcnCardForeground">#09090B</Color>

    <Color x:Key="ShadcnPopover">#FFFFFF</Color>
    <Color x:Key="ShadcnPopoverForeground">#09090B</Color>

    <!--  Primary (Dark/Black in standard Shadcn)  -->
    <Color x:Key="ShadcnPrimary">#18181B</Color>
    <Color x:Key="ShadcnPrimaryForeground">#FAFAFA</Color>

    <!--  Accent / Secondary  -->
    <Color x:Key="ShadcnSecondary">#F4F4F5</Color>
    <Color x:Key="ShadcnSecondaryForeground">#18181B</Color>

    <Color x:Key="ShadcnMuted">#F4F4F5</Color>
    <Color x:Key="ShadcnMutedForeground">#71717A</Color>

    <Color x:Key="ShadcnAccent">#F4F4F5</Color>
    <Color x:Key="ShadcnAccentForeground">#18181B</Color>

    <!--  Semantic / Statuses  -->
    <Color x:Key="ShadcnDestructive">#EF4444</Color>
    <Color x:Key="ShadcnDestructiveForeground">#F9FAFB</Color>

    <Color x:Key="ShadcnSuccess">#10B981</Color>
    <Color x:Key="ShadcnSuccessForeground">#F9FAFB</Color>

    <Color x:Key="ShadcnWarning">#F59E0B</Color>
    <Color x:Key="ShadcnWarningForeground">#F9FAFB</Color>

    <Color x:Key="ShadcnInfo">#3B82F6</Color>
    <Color x:Key="ShadcnInfoForeground">#F9FAFB</Color>

    <!--  UI Elements  -->
    <Color x:Key="ShadcnBorder">#E4E4E7</Color>
    <Color x:Key="ShadcnInput">#E4E4E7</Color>
    <Color x:Key="ShadcnRing">#A1A1AA</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="{StaticResource ShadcnBackground}" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="{StaticResource ShadcnForeground}" />

    <SolidColorBrush x:Key="ShadcnCardBrush" Color="{StaticResource ShadcnCard}" />
    <SolidColorBrush x:Key="ShadcnCardForegroundBrush" Color="{StaticResource ShadcnCardForeground}" />

    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="{StaticResource ShadcnPopover}" />
    <SolidColorBrush x:Key="ShadcnPopoverForegroundBrush" Color="{StaticResource ShadcnPopoverForeground}" />

    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="{StaticResource ShadcnPrimary}" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="{StaticResource ShadcnPrimaryForeground}" />

    <SolidColorBrush x:Key="ShadcnSecondaryBrush" Color="{StaticResource ShadcnSecondary}" />
    <SolidColorBrush x:Key="ShadcnSecondaryForegroundBrush" Color="{StaticResource ShadcnSecondaryForeground}" />

    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="{StaticResource ShadcnMuted}" />
    <SolidColorBrush x:Key="ShadcnMutedForegroundBrush" Color="{StaticResource ShadcnMutedForeground}" />

    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="{StaticResource ShadcnAccent}" />
    <SolidColorBrush x:Key="ShadcnAccentForegroundBrush" Color="{StaticResource ShadcnAccentForeground}" />

    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="{StaticResource ShadcnDestructive}" />
    <SolidColorBrush x:Key="ShadcnDestructiveForegroundBrush" Color="{StaticResource ShadcnDestructiveForeground}" />

    <SolidColorBrush x:Key="ShadcnSuccessBrush" Color="{StaticResource ShadcnSuccess}" />
    <SolidColorBrush x:Key="ShadcnSuccessForegroundBrush" Color="{StaticResource ShadcnSuccessForeground}" />

    <SolidColorBrush x:Key="ShadcnWarningBrush" Color="{StaticResource ShadcnWarning}" />
    <SolidColorBrush x:Key="ShadcnWarningForegroundBrush" Color="{StaticResource ShadcnWarningForeground}" />

    <SolidColorBrush x:Key="ShadcnInfoBrush" Color="{StaticResource ShadcnInfo}" />
    <SolidColorBrush x:Key="ShadcnInfoForegroundBrush" Color="{StaticResource ShadcnInfoForeground}" />

    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="{StaticResource ShadcnBorder}" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="{StaticResource ShadcnInput}" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="{StaticResource ShadcnRing}" />

    <!--  Embedded Google Font Family  -->
    <FontFamily x:Key="ShadcnFontFamily">pack://application:,,,/ATEC.PM.Client;component/Assets/Fonts/#Inter</FontFamily>

</ResourceDictionary>
