<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:ATEC.PM.Client.Helpers">

    <!--
        ===================================================================
        DATA INPUT STYLES & TEMPLATES (SHADCN UI)
        ===================================================================
    -->

    <!--  1. Textbox Style  -->
    <Style x:Key="ShadcnTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <!--  Tiny shadow under input  -->
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="2"
                                Direction="270"
                                Opacity="0.02"
                                ShadowDepth="1"
                                Color="Black" />
                        </Border.Effect>
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1A1AA" /> 
                            <!--  Zinc 400  -->
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <!--  Ring emulation: make border slightly thicker and darker  -->
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F4F4F5" />
                            <Setter Property="Foreground" Value="#71717A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F4F4F5" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#E4E4E7" />
                            <Setter Property="Foreground" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  PasswordBox Style  -->
    <Style x:Key="ShadcnPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <!--  Tiny shadow under input  -->
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="2"
                                Direction="270"
                                Opacity="0.02"
                                ShadowDepth="1"
                                Color="Black" />
                        </Border.Effect>
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1A1AA" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F4F4F5" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#E4E4E7" />
                            <Setter Property="Foreground" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Implicit style for all PasswordBox controls in the project  -->
    <Style BasedOn="{StaticResource ShadcnPasswordBox}" TargetType="PasswordBox" />

    <!--  2. CheckBox Style  -->
    <Style x:Key="ShadcnCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                        <BulletDecorator.Bullet>
                            <Border
                                x:Name="box"
                                Width="16"
                                Height="16"
                                Background="{DynamicResource ShadcnBackgroundBrush}"
                                BorderBrush="{DynamicResource ShadcnInputBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <!--  Checkmark Path  -->
                                <Path
                                    x:Name="checkmark"
                                    Width="10"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M1,3.5 L3.5,6 L9,1"
                                    Stroke="{DynamicResource ShadcnPrimaryForegroundBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter
                            Margin="8,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#A1A1AA" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="checkmark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Background" Value="#F4F4F5" />
                            <Setter TargetName="box" Property="BorderBrush" Value="#E4E4E7" />
                            <Setter Property="Foreground" Value="#A1A1AA" />
                            <Setter TargetName="checkmark" Property="Stroke" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  3. ToggleSwitch (Switch) Style  -->
    <Style x:Key="ShadcnSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!--  Switch Track  -->
                        <Border
                            x:Name="track"
                            Background="#E4E4E7"
                            CornerRadius="10"
                            SnapsToDevicePixels="True" />
                        <!--  Switch Thumb  -->
                        <Border
                            x:Name="thumb"
                            Width="16"
                            Height="16"
                            Margin="2,0,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="1"
                                    Direction="270"
                                    Opacity="0.1"
                                    ShadowDepth="1"
                                    Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="track" Property="Background" Value="#F4F4F5" />
                            <Setter TargetName="thumb" Property="Background" Value="#E4E4E7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  4. RadioButton Style  -->
    <Style x:Key="ShadcnRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                        <BulletDecorator.Bullet>
                            <Border
                                x:Name="outerCircle"
                                Width="16"
                                Height="16"
                                Background="{DynamicResource ShadcnBackgroundBrush}"
                                BorderBrush="{DynamicResource ShadcnInputBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <Ellipse
                                    x:Name="innerCircle"
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource ShadcnPrimaryBrush}"
                                    Visibility="Collapsed" />
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter
                            Margin="8,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerCircle" Property="BorderBrush" Value="#A1A1AA" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outerCircle" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="innerCircle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outerCircle" Property="Background" Value="#F4F4F5" />
                            <Setter TargetName="outerCircle" Property="BorderBrush" Value="#E4E4E7" />
                            <Setter TargetName="innerCircle" Property="Fill" Value="#A1A1AA" />
                            <Setter Property="Foreground" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  5. ComboBox Style  -->
    <!--  Custom ComboBox ToggleButton Template  -->
    <ControlTemplate x:Key="ShadcnComboBoxToggle" TargetType="ToggleButton">
        <Border
            x:Name="border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <!--  Arrow / Chevron  -->
                <Path
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0,0 L 4,4 L 8,0"
                    Stroke="{DynamicResource ShadcnMutedForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.5" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="#A1A1AA" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ShadcnComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--  Toggle button triggers drop down  -->
                        <ToggleButton
                            Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Template="{StaticResource ShadcnComboBoxToggle}" />

                        <!--  Content Presenter for selected item  -->
                        <ContentPresenter
                            Name="ContentSite"
                            Margin="12,0,32,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />

                        <!--  Popup showing items list  -->
                        <Popup
                            Name="Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <Grid
                                Name="DropDown"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                SnapsToDevicePixels="True">
                                <Border
                                    x:Name="DropDownBorder"
                                    Margin="0,4,0,4"
                                    Background="{DynamicResource ShadcnPopoverBrush}"
                                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Direction="270"
                                            Opacity="0.08"
                                            ShadowDepth="2"
                                            Color="Black" />
                                    </Border.Effect>
                                    <ScrollViewer
                                        Margin="2"
                                        HorizontalScrollBarVisibility="Auto"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ComboBox Item Style  -->
    <Style x:Key="ShadcnComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="border"
                        Margin="4,1"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  6. Slider Style  -->
    <Style x:Key="ShadcnSliderThumb" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse
                        x:Name="ellipse"
                        Width="16"
                        Height="16"
                        Fill="White"
                        Stroke="{DynamicResource ShadcnPrimaryBrush}"
                        StrokeThickness="1.5">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="2"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="1"
                                Color="Black" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource ShadcnSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ellipse" Property="Fill" Value="{DynamicResource ShadcnSecondaryBrush}" />
                            <Setter TargetName="ellipse" Property="StrokeThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShadcnSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  Track line  -->
                        <Border
                            x:Name="TrackBackground"
                            Grid.Row="1"
                            Height="4"
                            Margin="0,6"
                            Background="#E4E4E7"
                            CornerRadius="2"
                            SnapsToDevicePixels="true" />
                        <!--  Selection Range (Active fill)  -->
                        <Track Name="PART_Track" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border
                                                Height="4"
                                                Background="{DynamicResource ShadcnPrimaryBrush}"
                                                CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ShadcnSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  7. Calendar & DatePicker Styles  -->
    <Style x:Key="ShadcnCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border
                        x:Name="border"
                        Margin="1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            x:Name="content"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Hover state  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                        </Trigger>
                        <!--  Selection state  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ShadcnPrimaryForegroundBrush}" />
                        </Trigger>
                        <!--  Days from other months  -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <!--  Today highlighted with a small border  -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Base Calendar Item  -->
    <Style x:Key="ShadcnCalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <Grid Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Calendar Header (Month select, Prev/Next)  -->
                        <DockPanel
                            Grid.Row="0"
                            Margin="4,0,4,8"
                            LastChildFill="False">
                            <Button
                                Name="PART_PreviousButton"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                DockPanel.Dock="Left"
                                Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="4">
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 5,1 L 1,5 L 5,9"
                                                Stroke="{DynamicResource ShadcnForegroundBrush}"
                                                StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button
                                Name="PART_NextButton"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="4">
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 1,1 L 5,5 L 1,9"
                                                Stroke="{DynamicResource ShadcnForegroundBrush}"
                                                StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button
                                Name="PART_HeaderButton"
                                Height="28"
                                Margin="8,0"
                                Cursor="Hand"
                                DockPanel.Dock="Left"
                                Focusable="False"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ShadcnForegroundBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <!--  Calendar Days Grid  -->
                        <Grid Grid.Row="1">
                            <Grid Name="PART_MonthView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid Name="PART_YearView" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShadcnCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource ShadcnCalendarDayButton}" />
        <Setter Property="CalendarItemStyle" Value="{DynamicResource ShadcnCalendarItem}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                Direction="270"
                                Opacity="0.06"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <CalendarItem Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DatePicker Style  -->
    <Style x:Key="ShadcnDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <!--  Date text input styled as TextBox  -->
                        <Border
                            Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  Custom calendar button on right  -->
                                <Button
                                    Name="PART_Button"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Background="Transparent"
                                                CornerRadius="4">
                                                <!--  Calendar icon  -->
                                                <Path
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 2,1 L 10,1 L 10,2 L 2,2 Z M 2,4 L 10,4 L 10,10 L 2,10 Z M 1,3 L 11,3 L 11,11 L 1,11 Z"
                                                    Fill="{DynamicResource ShadcnMutedForegroundBrush}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!--  Editable text part  -->
                                <DatePickerTextBox
                                    Name="PART_TextBox"
                                    Grid.Column="0"
                                    Margin="12,0,0,0"
                                    Padding="0"
                                    VerticalContentAlignment="Center"
                                    Focusable="{TemplateBinding Focusable}" />
                            </Grid>
                        </Border>
                        <!--  Standard DatePicker Popout with Styled Calendar  -->
                        <Popup
                            Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=Border}"
                            PopupAnimation="Slide">
                            <Calendar
                                Name="PART_Calendar"
                                Margin="0,4,0,4"
                                Style="{StaticResource ShadcnCalendar}" />
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#A1A1AA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DatePicker: modifica solo tramite calendario (no digitazione manuale)  -->
    <Style
        x:Key="ShadcnDatePickerPickerOnly"
        BasedOn="{StaticResource ShadcnDatePicker}"
        TargetType="DatePicker">
        <Setter Property="helpers:DatePickerAssist.PickerOnly" Value="True" />
    </Style>

</ResourceDictionary>
