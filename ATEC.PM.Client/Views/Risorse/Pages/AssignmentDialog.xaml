<Window
    x:Class="ATEC.PM.Client.Views.Risorse.AssignmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Allocazione"
    Width="600"
    MaxHeight="850"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    FontFamily="{StaticResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FormLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--  Stile riga compatto per la griglia risorse  -->
        <Style
            x:Key="CompactGridRow"
            BasedOn="{StaticResource ShadcnRow}"
            TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <!--  Stile cella compatto per la griglia risorse  -->
        <Style
            x:Key="CompactGridCell"
            BasedOn="{StaticResource ShadcnCell}"
            TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--  Stile header compatto per la griglia risorse  -->
        <Style
            x:Key="CompactGridHeader"
            BasedOn="{StaticResource ShadcnColumnHeader}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--  HEADER  -->
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <TextBlock
                x:Name="txtTitle"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ShadcnForegroundBrush}"
                Text="Nuova allocazione" />
        </Border>

        <!--  BUTTONS  -->
        <Border
            Padding="20,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="96"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"
                    Content="Annulla"
                    Style="{StaticResource ShadcnButtonOutline}" />
                <Button
                    Width="96"
                    Click="BtnOk_Click"
                    Content="Salva"
                    Style="{StaticResource ShadcnButtonDefault}" />
            </StackPanel>
        </Border>

        <!--  FORM  -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">
                <TextBlock
                    x:Name="lblResources"
                    Style="{StaticResource FormLbl}"
                    Text="RISORSE *" />
                <!--  Risorsa singola: persona già nota (drag su riga / disegno / doppio click / modifica)  -->
                <Border
                    x:Name="singleResourcePanel"
                    Margin="0,0,0,14"
                    Padding="12,10"
                    Background="{DynamicResource ShadcnMutedBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="singleResourceText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="" />
                </Border>
                <!--  Risorse multiple: griglia con checkbox + seleziona/deseleziona tutti  -->
                <Border
                    x:Name="multiResourcePanel"
                    Margin="0,0,0,14"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="6">
                    <DataGrid
                        x:Name="dgResources"
                        Height="347"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CellStyle="{StaticResource CompactGridCell}"
                        ColumnHeaderStyle="{StaticResource CompactGridHeader}"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowStyle="{StaticResource CompactGridRow}"
                        SelectionMode="Single"
                        Style="{StaticResource ShadcnDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="46"
                                CanUserResize="False"
                                CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox
                                        x:Name="chkSelectAll"
                                        HorizontalAlignment="Center"
                                        Checked="ChkSelectAll_Changed"
                                        ToolTip="Seleziona / deseleziona tutti"
                                        Unchecked="ChkSelectAll_Changed" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Risorsa"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLbl}" Text="TIPO" />
                        <ComboBox x:Name="cmbTipo" Style="{StaticResource ShadcnComboBox}">
                            <ComboBoxItem
                                Content="Operativo"
                                IsSelected="True"
                                Tag="OP" />
                            <ComboBoxItem Content="Flessibile" Tag="FLEX" />
                            <ComboBoxItem Content="Ferie" Tag="FERIE" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLbl}" Text="DATA INIZIO *" />
                        <DatePicker x:Name="dpInizio" Style="{StaticResource ShadcnDatePickerPickerOnly}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FormLbl}" Text="DATA FINE *" />
                        <DatePicker x:Name="dpFine" Style="{StaticResource ShadcnDatePickerPickerOnly}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FormLbl}" Text="COMMESSA" />
                <ComboBox
                    x:Name="cmbCommessa"
                    Margin="0,0,0,14"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    Style="{StaticResource ShadcnComboBox}" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLbl}" Text="SERVICE" />
                        <ComboBox
                            x:Name="cmbService"
                            DisplayMemberPath="Display"
                            SelectedValuePath="Id"
                            Style="{StaticResource ShadcnComboBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLbl}" Text="ALTRA ATTIVITÀ" />
                        <ComboBox
                            x:Name="cmbAltra"
                            DisplayMemberPath="Descrizione"
                            SelectedValuePath="Id"
                            Style="{StaticResource ShadcnComboBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FormLbl}" Text="DESCRIZIONE" />
                <TextBox x:Name="txtDescrizione" Style="{StaticResource ShadcnTextBox}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
