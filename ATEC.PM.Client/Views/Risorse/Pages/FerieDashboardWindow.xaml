<Window
    x:Class="ATEC.PM.Client.Views.Risorse.FerieDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Piano ferie"
    Width="1180"
    Height="740"
    MinWidth="900"
    MinHeight="560"
    FontFamily="{StaticResource ShadcnFontFamily}"
    Background="{DynamicResource ShadcnMutedBrush}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ShadcnCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--  HEADER  -->
        <Border
            Padding="20,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="Piano ferie" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="Panoramica di ferie e permessi delle risorse" />
                </StackPanel>
                <Button
                    Width="96"
                    HorizontalAlignment="Right"
                    Click="BtnClose_Click"
                    Content="Chiudi"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ShadcnButtonOutline}" />
            </DockPanel>
        </Border>

        <!--  STATUS BAR  -->
        <Border
            Padding="20,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="" />
        </Border>

        <!--  KPI  -->
        <Grid Margin="16,14,16,0" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Colleghi con ferie" />
                    <TextBlock x:Name="txtKpiColleghi" Style="{StaticResource KpiValue}" Text="0" />
                    <TextBlock x:Name="txtKpiColleghiSub" Style="{StaticResource KpiLabel}" Text="su 0 risorse" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Giorni di ferie totali" />
                    <TextBlock x:Name="txtKpiGiorni" Style="{StaticResource KpiValue}" Text="0" />
                    <TextBlock Style="{StaticResource KpiLabel}" Text="su tutto il piano" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Picco contemporaneo" />
                    <TextBlock x:Name="txtKpiPicco" Style="{StaticResource KpiValue}" Text="0" />
                    <TextBlock x:Name="txtKpiPiccoSub" Style="{StaticResource KpiLabel}" Text="—" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  CONTROLS  -->
        <Border Margin="16,12,16,0" DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Width="40" Margin="0,0,4,0" Click="BtnPrev_Click" Content="◀" Style="{StaticResource ShadcnButtonOutline}" />
                    <Button Margin="0,0,4,0" Click="BtnToday_Click" Content="Oggi" Style="{StaticResource ShadcnButtonOutline}" />
                    <Button Width="40" Margin="0,0,8,0" Click="BtnNext_Click" Content="▶" Style="{StaticResource ShadcnButtonOutline}" />
                    <TextBlock
                        x:Name="txtPeriod"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="—" />
                    <ComboBox
                        x:Name="cmbWindow"
                        Width="120"
                        VerticalAlignment="Center"
                        SelectionChanged="CmbWindow_SelectionChanged"
                        Style="{StaticResource ShadcnComboBox}">
                        <ComboBoxItem Content="2 settimane" Tag="14" />
                        <ComboBoxItem Content="4 settimane" IsSelected="True" Tag="28" />
                        <ComboBoxItem Content="8 settimane" Tag="56" />
                    </ComboBox>
                    <Button
                        Width="34"
                        Height="34"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Content="?"
                        FontWeight="SemiBold"
                        Style="{StaticResource ShadcnButtonOutline}">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel Margin="2">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Scorciatoie" />
                                    <TextBlock FontSize="11" Text="Trascina barra — sposta le ferie" />
                                    <TextBlock FontSize="11" Text="Bordi barra — ridimensiona inizio/fine" />
                                    <TextBlock FontSize="11" Text="Trascina su riga vuota — crea ferie" />
                                    <TextBlock FontSize="11" Text="« + » accanto al nome — aggiungi 1 giorno" />
                                    <TextBlock FontSize="11" Text="Doppio click barra — modifica le date" />
                                    <TextBlock FontSize="11" Text="Trascina al bordo — scorre la finestra" />
                                    <TextBlock FontSize="11" Text="Shift + trascina — snap a settimana" />
                                    <TextBlock FontSize="11" Text="Esc — annulla drag" />
                                    <TextBlock FontSize="11" Text="Ctrl / Shift + rotella — zoom / pan" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="Nomi:" />
                    <ComboBox
                        x:Name="cmbFilter"
                        Width="150"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        SelectionChanged="CmbFilter_SelectionChanged"
                        Style="{StaticResource ShadcnComboBox}">
                        <ComboBoxItem Content="Tutti i nomi" IsSelected="True" Tag="all" />
                        <ComboBoxItem Content="Solo con ferie" Tag="ferie" />
                        <ComboBoxItem Content="Solo selezionati" Tag="sel" />
                    </ComboBox>
                    <Button Margin="0,0,4,0" Click="BtnSelAll_Click" Content="Sel. tutti" Style="{StaticResource ShadcnButtonOutline}" />
                    <Button Margin="0,0,12,0" Click="BtnSelNone_Click" Content="Sel. nessuno" Style="{StaticResource ShadcnButtonOutline}" />
                    <Button Click="BtnExport_Click" Content="Esporta CSV" Style="{StaticResource ShadcnButtonOutline}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  TIMELINE  -->
        <Border
            Margin="16,12,16,16"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="14,6"
                        Background="#FAFAFA"
                        BorderBrush="{DynamicResource ShadcnBorderBrush}"
                        BorderThickness="0,0,1,1">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            Text="Risorsa" />
                    </Border>
                    <Grid x:Name="headerHostWrap" Grid.Column="1">
                        <Grid x:Name="headerHost" />
                    </Grid>
                </Grid>

                <!--  Body  -->
                <ScrollViewer
                    x:Name="bodyVScroll"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="namesColumn" Grid.Column="0" />
                        <Grid x:Name="timelineBody" Grid.Column="1" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
