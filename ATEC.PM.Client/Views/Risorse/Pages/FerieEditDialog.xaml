<Window
    x:Class="ATEC.PM.Client.Views.Risorse.FerieEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Modifica ferie"
    Width="440"
    Height="360"
    FontFamily="{StaticResource ShadcnFontFamily}"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FormLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--  HEADER  -->
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnForegroundBrush}"
                    Text="Modifica ferie" />
                <TextBlock
                    x:Name="txtResource"
                    FontSize="11"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="" />
            </StackPanel>
        </Border>

        <!--  BUTTONS  -->
        <Border
            Padding="20,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <Button
                    Width="96"
                    Click="BtnDelete_Click"
                    Content="Elimina"
                    DockPanel.Dock="Left"
                    Style="{StaticResource ShadcnButtonOutline}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="96"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonOutline}" />
                    <Button
                        Width="96"
                        Click="BtnOk_Click"
                        Content="Salva"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  FORM  -->
        <StackPanel Margin="20,16">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FormLbl}" Text="DATA INIZIO *" />
                    <DatePicker x:Name="dpInizio" Style="{StaticResource ShadcnDatePickerPickerOnly}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FormLbl}" Text="DATA FINE *" />
                    <DatePicker x:Name="dpFine" Style="{StaticResource ShadcnDatePickerPickerOnly}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FormLbl}" Text="DESCRIZIONE" />
            <TextBox x:Name="txtDescrizione" Style="{StaticResource ShadcnTextBox}" />
        </StackPanel>
    </DockPanel>
</Window>
