<Page
    x:Class="ATEC.PM.Client.Views.Risorse.ResourcePlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="720"
    Focusable="True"
    FontFamily="{StaticResource ShadcnFontFamily}"
    Background="{DynamicResource ShadcnMutedBrush}"
    PreviewKeyDown="Page_PreviewKeyDown"
    PreviewMouseWheel="Gantt_PreviewMouseWheel">

    <Page.Resources>
        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Trascina su un giorno del Gantt (1 gg, poi ridimensiona)" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ShadcnMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LegendLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>
        <Style x:Key="FilterChk" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>
        <Style x:Key="HelpLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HelpSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Page.Resources>

    <Grid>
    <DockPanel>
        <!--  Toolbar principale  -->
        <Border
            Padding="12,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnNew" Margin="0,0,8,0" Click="BtnNew_Click" Content="+ Allocazione" Style="{StaticResource ShadcnButtonDefault}" />
                    <Border Width="1" Margin="4,2" Background="{DynamicResource ShadcnBorderBrush}" />
                    <Button Width="40" Margin="0,0,4,0" Click="BtnPrev_Click" Content="◀" Style="{StaticResource ShadcnButtonOutline}" ToolTip="Indietro 7 giorni" />
                    <Button Margin="0,0,4,0" Click="BtnToday_Click" Content="Oggi" Style="{StaticResource ShadcnButtonOutline}" />
                    <Button Width="40" Margin="0,0,8,0" Click="BtnNext_Click" Content="▶" Style="{StaticResource ShadcnButtonOutline}" ToolTip="Avanti 7 giorni" />
                    <TextBlock
                        x:Name="txtPeriod"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="—" />
                    <ComboBox
                        x:Name="cmbWindow"
                        Width="130"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        SelectionChanged="CmbWindow_SelectionChanged"
                        Style="{StaticResource ShadcnComboBox}"
                        ToolTip="Finestra temporale (Ctrl + rotella zoom, Shift + rotella pan)">
                        <ComboBoxItem Content="2 settimane" Tag="14" />
                        <ComboBoxItem Content="4 settimane" IsSelected="True" Tag="28" />
                        <ComboBoxItem Content="8 settimane" Tag="56" />
                    </ComboBox>
                    <Button
                        Margin="0,0,8,0"
                        Click="BtnFeriePlan_Click"
                        Content="Piano ferie"
                        Style="{StaticResource ShadcnButtonOutline}"
                        ToolTip="Dashboard ferie e permessi" />
                    <Button
                        x:Name="btnHelp"
                        Width="34"
                        Height="34"
                        Click="BtnHelp_Click"
                        Content="?"
                        FontWeight="SemiBold"
                        Style="{StaticResource ShadcnButtonOutline}"
                        ToolTip="Scorciatoie da tastiera e mouse" />
                    <Popup
                        x:Name="helpPopup"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=btnHelp}"
                        StaysOpen="False">
                        <Border
                            MinWidth="320"
                            MaxWidth="380"
                            Padding="14,12"
                            Background="{DynamicResource ShadcnCardBrush}"
                            BorderBrush="{DynamicResource ShadcnBorderBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ShadcnForegroundBrush}"
                                    Text="Scorciatoie" />
                                <TextBlock Style="{StaticResource HelpSection}" Text="GANTT · MOUSE" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Trascina barra — sposta le date (fluido; snap settimana con Shift)" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Bordi barra — ridimensiona inizio/fine" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Al bordo timeline — auto-pan ±7 gg (solo spostamento)" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Alt + trascina — copia allocazione" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Shift + trascina — snap a settimane" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Trascina causale sul Gantt — 1 giorno, poi ridimensiona" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Trascina su riga vuota — nuova allocazione" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Click — seleziona · Doppio click — modifica" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Tasto destro — menu contestuale" />
                                <TextBlock Style="{StaticResource HelpSection}" Text="TASTIERA" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Esc — annulla drag in corso" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Canc — elimina barra selezionata" />
                                <TextBlock Style="{StaticResource HelpSection}" Text="NAVIGAZIONE" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Ctrl + rotella — zoom timeline" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="Shift + rotella — pan ±7 giorni" />
                                <TextBlock Style="{StaticResource HelpLine}" Text="◀ ▶ — settimana precedente / successiva" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Orientation="Horizontal">
                    <!--  Causali trascinabili: nascoste in modalità sola-lettura (gating resources.edit)  -->
                    <StackPanel x:Name="legendChips" Orientation="Horizontal">
                        <Border Tag="OP" MouseLeftButtonDown="Legend_MouseLeftButtonDown" Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LegendDot}" Background="#3B82F6" />
                                <TextBlock Style="{StaticResource LegendLbl}" Text="Operativo" />
                            </StackPanel>
                        </Border>
                        <Border Tag="FLEX" MouseLeftButtonDown="Legend_MouseLeftButtonDown" Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LegendDot}" Background="#9CA3AF" />
                                <TextBlock Style="{StaticResource LegendLbl}" Text="Flessibile" />
                            </StackPanel>
                        </Border>
                        <Border Tag="FERIE" MouseLeftButtonDown="Legend_MouseLeftButtonDown" Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource LegendDot}" Background="#EF4444" />
                                <TextBlock Style="{StaticResource LegendLbl}" Text="Ferie" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBox
                        x:Name="txtSearch"
                        Width="150"
                        Height="34"
                        Margin="14,0,0,0"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource ShadcnTextBox}"
                        TextChanged="TxtSearch_TextChanged"
                        ToolTip="Cerca risorsa" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Filtri  -->
        <Border
            Padding="12,6"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="chkConflictsOnly"
                    Checked="Filter_Changed"
                    Content="Solo conflitti"
                    Style="{StaticResource FilterChk}"
                    Unchecked="Filter_Changed" />
                <CheckBox
                    x:Name="chkOccupiedOnly"
                    Checked="Filter_Changed"
                    Content="Solo occupate"
                    Style="{StaticResource FilterChk}"
                    Unchecked="Filter_Changed" />
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="Tipo:" />
                <ComboBox
                    x:Name="cmbTipoFilter"
                    Width="110"
                    Margin="0,0,12,0"
                    SelectionChanged="Filter_Changed"
                    Style="{StaticResource ShadcnComboBox}">
                    <ComboBoxItem Content="Tutti" IsSelected="True" Tag="" />
                    <ComboBoxItem Content="Operativo" Tag="OP" />
                    <ComboBoxItem Content="Flessibile" Tag="FLEX" />
                    <ComboBoxItem Content="Ferie" Tag="FERIE" />
                </ComboBox>
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="Commessa:" />
                <ComboBox
                    x:Name="cmbProjectFilter"
                    Width="180"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    SelectionChanged="Filter_Changed"
                    Style="{StaticResource ShadcnComboBox}" />
            </StackPanel>
        </Border>

        <!--  Pannello conflitti  -->
        <Border
            x:Name="conflictPanel"
            MaxHeight="100"
            Padding="12,6"
            Background="#FEF2F2"
            BorderBrush="#FECACA"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            Visibility="Collapsed">
            <DockPanel>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#B91C1C"
                    Text="⚠ Conflitti" />
                <ListBox
                    x:Name="lstConflicts"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="LstConflicts_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Background="{DynamicResource ShadcnCardBrush}"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand">
                                <TextBlock FontSize="11" Text="{Binding Label}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Padding="16,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Pronto" />
        </Border>

        <!--  GANTT  -->
        <Border
            Margin="12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="12,6"
                        Background="#FAFAFA"
                        BorderBrush="{DynamicResource ShadcnBorderBrush}"
                        BorderThickness="0,0,1,1">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            Text="Risorsa" />
                    </Border>
                    <ScrollViewer
                        x:Name="headerHScroll"
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        ScrollChanged="TimelineHScroll_ScrollChanged">
                        <Grid x:Name="headerHost" />
                    </ScrollViewer>
                </Grid>

                <!--  Body  -->
                <ScrollViewer
                    x:Name="bodyVScroll"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="bodyGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="namesColumn" Grid.Column="0" />
                        <ScrollViewer
                            x:Name="bodyHScroll"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            ScrollChanged="TimelineHScroll_ScrollChanged">
                            <Grid x:Name="timelineBody" />
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        </DockPanel>

        <!--  Tooltip durata durante drag/resize  -->
        <Popup
            x:Name="dragTooltipPopup"
            AllowsTransparency="True"
            IsHitTestVisible="False"
            Placement="Relative"
            StaysOpen="True">
            <Border
                Padding="8,5"
                Background="{DynamicResource ShadcnCardBrush}"
                BorderBrush="{DynamicResource ShadcnBorderBrush}"
                BorderThickness="1">
                <TextBlock
                    x:Name="txtDragTooltip"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnForegroundBrush}" />
            </Border>
        </Popup>
    </Grid>
</Page>
