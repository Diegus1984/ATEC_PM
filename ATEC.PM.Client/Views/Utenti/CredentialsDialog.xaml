<Window
    x:Class="ATEC.PM.Client.Views.CredentialsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Imposta Credenziali"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="24" CornerRadius="8">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource ShadcnH3}"
                Text="Imposta credenziali di accesso" />

            <TextBlock
                Margin="0,0,0,6"
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Username" />
            <TextBox
                x:Name="txtUsername"
                Style="{StaticResource ShadcnTextBox}"
                Margin="0,0,0,16" />

            <TextBlock
                Margin="0,0,0,6"
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Password" />
            <PasswordBox
                x:Name="txtPassword"
                Style="{StaticResource ShadcnPasswordBox}"
                Margin="0,0,0,16" />

            <TextBlock
                Margin="0,0,0,6"
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Conferma Password" />
            <PasswordBox
                x:Name="txtPasswordConfirm"
                Style="{StaticResource ShadcnPasswordBox}"
                Margin="0,0,0,16" />

            <TextBlock
                x:Name="txtError"
                Margin="0,4,0,0"
                Style="{StaticResource ShadcnSmall}"
                Foreground="{DynamicResource ShadcnDestructiveBrush}"
                TextWrapping="Wrap" />

            <StackPanel
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="90"
                    Click="BtnCancel_Click"
                    Content="Annulla"
                    Style="{StaticResource ShadcnButtonOutline}"
                    IsCancel="True"
                    Margin="0,0,8,0" />
                <Button
                    x:Name="btnSave"
                    Width="90"
                    Click="BtnSave_Click"
                    Content="Salva"
                    Style="{StaticResource ShadcnButtonDefault}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>