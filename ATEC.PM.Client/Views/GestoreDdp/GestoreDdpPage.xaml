<Page
    x:Class="ATEC.PM.Client.Views.GestoreDdp.GestoreDdpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ATEC.PM.Client.Views.GestoreDdp"
    MinWidth="900"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}">

    <Page.Resources>
        <!--  Stili etichette KPI  -->
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        </Style>
        <Style x:Key="KpiLab" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>

        <!--  Gruppo commessa (intestazione codice — cliente) + card DDP  -->
        <DataTemplate DataType="{x:Type local:DdpProjectCardVM}">
            <StackPanel Margin="0,0,0,22">
                <!--  Intestazione gruppo commessa  -->
                <StackPanel
                    Margin="2,0,0,9"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Bottom"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="{Binding Code}" />
                    <TextBlock
                        Margin="12,0,0,1"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="{Binding CustomerName}" />
                </StackPanel>

                <!--  Card DDP Commerciale  -->
                <Border
                    Width="460"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource ShadcnCardBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel Margin="18,16,18,16">
                        <!--  Riga: pill tipo + (azioni future)  -->
                        <DockPanel>
                            <Border
                                Padding="10,3"
                                HorizontalAlignment="Left"
                                Background="#E3EEF9"
                                BorderBrush="#BBD2E6"
                                BorderThickness="1"
                                CornerRadius="9"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#2E5C8A"
                                    Text="COMMERCIALE" />
                            </Border>
                        </DockPanel>

                        <!--  Riga date: inserita / finestra consegne  -->
                        <Grid Margin="0,12,0,14">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="11.5"
                                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                Text="{Binding InsertedLabel}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11.5"
                                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                Text="{Binding DeliveryLabel}" />
                        </Grid>

                        <!--  Griglia 2x2 KPI  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource KpiVal}" Foreground="#C0392B" Text="{Binding TotAcquistiLabel}" />
                                <TextBlock Style="{StaticResource KpiLab}" Text="TOT. ACQUISTI" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource KpiVal}" Text="{Binding TotalRows}" />
                                <TextBlock Style="{StaticResource KpiLab}" Text="INSERIMENTI" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Style="{StaticResource KpiVal}" Text="{Binding DatedCount}" />
                                <TextBlock Style="{StaticResource KpiLab}" Text="MAT. CONSEGNA" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Style="{StaticResource KpiVal}" Foreground="{Binding OverdueBrush}" Text="{Binding OverdueCount}" />
                                <TextBlock Style="{StaticResource KpiLab}" Text="MAT. RITARDO" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,16,0,12" Background="{DynamicResource ShadcnBorderBrush}" />

                        <!--  Footer: apri sintesi  -->
                        <DockPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="BtnOpenSintesi_Click"
                                Content="Apri sintesi"
                                DockPanel.Dock="Right"
                                Style="{DynamicResource ShadcnButtonDefault}"
                                Tag="{Binding ProjectId}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <DockPanel>
        <!--  Toolbar  -->
        <Border
            Padding="12,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <Button
                    Margin="0,0,16,0"
                    Click="BtnRefresh_Click"
                    Content="Aggiorna"
                    DockPanel.Dock="Left"
                    Style="{DynamicResource ShadcnButtonOutline}" />
                <Grid Width="220" HorizontalAlignment="Left">
                    <TextBox
                        x:Name="txtSearch"
                        Height="32"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        Style="{DynamicResource ShadcnTextBox}"
                        TextChanged="TxtSearch_TextChanged" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        IsHitTestVisible="False"
                        Text="Cerca commessa o cliente...">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Padding="16,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Pronto" />
        </Border>

        <!--  Gruppi per commessa  -->
        <ScrollViewer
            Padding="16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    x:Name="txtEmpty"
                    Margin="2,4,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="Nessuna commessa con DDP Commerciali."
                    Visibility="Collapsed" />
                <ItemsControl x:Name="icCards" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
