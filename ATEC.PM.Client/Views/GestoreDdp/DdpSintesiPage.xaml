<Page
    x:Class="ATEC.PM.Client.Views.GestoreDdp.DdpSintesiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ATEC.PM.Client.Views.GestoreDdp"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}">

    <Page.Resources>
        <!--  Codice stato → etichetta (da Conf. DDP), come nella DDP sotto commessa  -->
        <local:DdpStatusLabelConverter x:Key="DdpStatusLabel" />
        <!--  Data prevista con "⚠" se scaduta (Materiale in Consegna)  -->
        <local:OverdueDateConverter x:Key="OverdueDate" />

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ShadcnCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="170" />
        </Style>
        <Style x:Key="KpiVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        </Style>
        <Style x:Key="KpiLab" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>

        <!--  Riga ripartizione per stato / destinazioni (barre)  -->
        <DataTemplate DataType="{x:Type local:BarRowVM}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="7,2"
                    HorizontalAlignment="Left"
                    Background="{Binding Background}"
                    CornerRadius="9">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground}" Text="{Binding Key}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource ShadcnForegroundBrush}"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    Grid.Column="2"
                    Height="9"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ShadcnBorderBrush}"
                    CornerRadius="5">
                    <Border
                        Width="{Binding BarWidth}"
                        HorizontalAlignment="Left"
                        Background="{Binding Background}"
                        CornerRadius="5" />
                </Border>
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="{Binding Count}" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="{Binding Pct}" />
            </Grid>
        </DataTemplate>

        <!--  Card "Stato Avanzamento" (A5)  -->
        <DataTemplate DataType="{x:Type local:AvanzCardVM}">
            <Border
                Width="132"
                Margin="0,0,10,10"
                Padding="12,10"
                Background="{Binding CardBg}"
                BorderBrush="{Binding CardBorder}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#475569" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="Bold" Foreground="#1A1D26" Text="{Binding Count}" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#64748B" Text="{Binding PctLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Accordion: stile sezioni espandibili  -->
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource ShadcnCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="ExpHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        </Style>
    </Page.Resources>

    <DockPanel>
        <!--  Header  -->
        <Border
            Padding="14,10"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <Button Margin="0,0,14,0" Click="BtnBack_Click" Content="← Indietro" DockPanel.Dock="Left" Style="{DynamicResource ShadcnButtonOutline}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Click="BtnExportExcel_Click" Content="Esporta Excel" Style="{DynamicResource ShadcnButtonOutline}" />
                    <Button Click="BtnPrint_Click" Content="🖨 Stampa" Style="{DynamicResource ShadcnButtonOutline}" />
                </StackPanel>
                <TextBlock x:Name="txtTitle" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="Sintesi DDP" />
            </DockPanel>
        </Border>

        <!--  KPI sempre visibili  -->
        <Border Padding="18,14,18,2" Background="{DynamicResource ShadcnMutedBrush}" DockPanel.Dock="Top">
            <WrapPanel>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiTot" Style="{StaticResource KpiVal}" Foreground="#C0392B" Text="€ 0,00" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="TOT. ACQUISTI" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiIns" Style="{StaticResource KpiVal}" Text="0" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="INSERIMENTI" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Width="210">
                    <StackPanel>
                        <TextBlock x:Name="kpiFin" Style="{StaticResource KpiVal}" FontSize="13" Text="n/d" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="FINESTRA CONSEGNE" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiCons" Style="{StaticResource KpiVal}" Text="0" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="MAT. IN CONSEGNA" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiRit" Style="{StaticResource KpiVal}" Text="0" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="MAT. IN RITARDO" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiConsegnato" Style="{StaticResource KpiVal}" Text="0" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="MAT. CONSEGNATO" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="kpiParziali" Style="{StaticResource KpiVal}" Text="0" />
                        <TextBlock Style="{StaticResource KpiLab}" Text="MAT. PARZIALI" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!--  Stati Avanzamento — sempre visibile, sotto i KPI  -->
        <Border Padding="18,2,18,8" Background="{DynamicResource ShadcnMutedBrush}" DockPanel.Dock="Top">
            <StackPanel>
                <DockPanel Margin="2,0,0,2">
                    <Button DockPanel.Dock="Right" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="avanz" Style="{DynamicResource ShadcnButtonOutline}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="Stati Avanzamento" />
                </DockPanel>
                <TextBlock x:Name="txtAvanzSub" Margin="2,0,0,8" FontSize="11" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="" />
                <ItemsControl x:Name="icAvanz">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  Status bar  -->
        <Border Padding="16,8" Background="{DynamicResource ShadcnCardBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
            <TextBlock x:Name="txtStatus" FontSize="11" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Pronto" />
        </Border>

        <!--  Opzione locale (salvata per utente): una vs più sezioni aperte  -->
        <Border Padding="18,2,18,4" Background="{DynamicResource ShadcnMutedBrush}" DockPanel.Dock="Top">
            <CheckBox
                x:Name="chkMultiOpen"
                HorizontalAlignment="Right"
                Click="ChkMultiOpen_Click"
                Content="Più sezioni aperte"
                FontSize="12"
                Style="{DynamicResource ShadcnCheckBox}" />
        </Border>

        <!--  Accordion  -->
        <ScrollViewer Margin="18,6,18,12" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="accordionPanel">

                <Expander IsExpanded="True" Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Ripartizione per stato" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="rip" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="6,8,6,8">
                        <TextBlock x:Name="txtRipSub" Margin="0,0,0,12" FontSize="11.5" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="" />
                        <ItemsControl x:Name="icRip" />
                    </StackPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Materiale in Consegna" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="consegne" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,0">
                        <DataGrid
                            x:Name="dgConsegne"
                            MaxHeight="420"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="50" Binding="{Binding RowNumber}" Header="#" />
                                <DataGridTextColumn Width="90" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Header="Data" />
                                <DataGridTextColumn Width="110" Binding="{Binding RequestedBy}" Header="Rich." />
                                <DataGridTextColumn Width="120" Binding="{Binding PartNumber}" Header="Codice" />
                                <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Description}" Header="Descrizione" />
                                <DataGridTextColumn Width="60" Binding="{Binding Quantity, StringFormat=0.##}" Header="Qtà" />
                                <DataGridTextColumn Width="50" Binding="{Binding Unit}" Header="UM" />
                                <DataGridTextColumn Width="130" Binding="{Binding SupplierName}" Header="Fornitore" />
                                <DataGridTextColumn Width="120" Binding="{Binding Manufacturer}" Header="Produttore" />
                                <DataGridTextColumn Width="150" Binding="{Binding ItemStatus, Converter={StaticResource DdpStatusLabel}}" Header="Stato" />
                                <DataGridTextColumn Width="90" Binding="{Binding DaneaRef}" Header="Rif. Danea" />
                                <DataGridTextColumn Width="100" Binding="{Binding DateNeeded, Converter={StaticResource OverdueDate}}" Header="Data prev." />
                                <DataGridTextColumn Width="120" Binding="{Binding Destination}" Header="Destinazione" />
                                <DataGridTextColumn Width="200" Binding="{Binding Notes}" Header="Note" />
                                <DataGridTextColumn Width="100" Binding="{Binding UnitCost, StringFormat='€ {0:N2}'}" Header="Costo un." />
                                <DataGridTextColumn Width="110" Binding="{Binding TotalCost, StringFormat='€ {0:N2}'}" Header="Totale" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            x:Name="txtConsegneSub"
                            Margin="2,8,0,2"
                            FontSize="11"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            Text="" />
                    </StackPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Materiale Consegnato" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="consegnato" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,0">
                        <DataGrid
                            x:Name="dgConsegnato"
                            MaxHeight="420"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="50" Binding="{Binding RowNumber}" Header="#" />
                                <DataGridTextColumn Width="90" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Header="Data" />
                                <DataGridTextColumn Width="110" Binding="{Binding RequestedBy}" Header="Rich." />
                                <DataGridTextColumn Width="120" Binding="{Binding PartNumber}" Header="Codice" />
                                <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Description}" Header="Descrizione" />
                                <DataGridTextColumn Width="60" Binding="{Binding Quantity, StringFormat=0.##}" Header="Qtà" />
                                <DataGridTextColumn Width="50" Binding="{Binding Unit}" Header="UM" />
                                <DataGridTextColumn Width="130" Binding="{Binding SupplierName}" Header="Fornitore" />
                                <DataGridTextColumn Width="120" Binding="{Binding Manufacturer}" Header="Produttore" />
                                <DataGridTextColumn Width="150" Binding="{Binding ItemStatus, Converter={StaticResource DdpStatusLabel}}" Header="Stato" />
                                <DataGridTextColumn Width="90" Binding="{Binding DaneaRef}" Header="Rif. Danea" />
                                <DataGridTextColumn Width="100" Binding="{Binding DateNeeded, StringFormat=dd/MM/yyyy}" Header="Data prev." />
                                <DataGridTextColumn Width="120" Binding="{Binding Destination}" Header="Destinazione" />
                                <DataGridTextColumn Width="200" Binding="{Binding Notes}" Header="Note" />
                                <DataGridTextColumn Width="100" Binding="{Binding UnitCost, StringFormat='€ {0:N2}'}" Header="Costo un." />
                                <DataGridTextColumn Width="110" Binding="{Binding TotalCost, StringFormat='€ {0:N2}'}" Header="Totale" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            x:Name="txtConsegnatoSub"
                            Margin="2,8,0,2"
                            FontSize="11"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            Text="" />
                    </StackPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Top 10 Costi" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="top10" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <DataGrid
                        x:Name="dgTop10"
                        MaxHeight="420"
                        Margin="0,6,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="44" Binding="{Binding Rank}" Header="Pos." />
                            <DataGridTextColumn Width="50" Binding="{Binding Item.RowNumber}" Header="#" />
                            <DataGridTextColumn Width="90" Binding="{Binding Item.CreatedAt, StringFormat=dd/MM/yyyy}" Header="Data" />
                            <DataGridTextColumn Width="110" Binding="{Binding Item.RequestedBy}" Header="Rich." />
                            <DataGridTextColumn Width="120" Binding="{Binding Item.PartNumber}" Header="Codice" />
                            <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Item.Description}" Header="Descrizione" />
                            <DataGridTextColumn Width="60" Binding="{Binding Item.Quantity, StringFormat=0.##}" Header="Qtà" />
                            <DataGridTextColumn Width="50" Binding="{Binding Item.Unit}" Header="UM" />
                            <DataGridTextColumn Width="130" Binding="{Binding Item.SupplierName}" Header="Fornitore" />
                            <DataGridTextColumn Width="120" Binding="{Binding Item.Manufacturer}" Header="Produttore" />
                            <DataGridTextColumn Width="150" Binding="{Binding Item.ItemStatus, Converter={StaticResource DdpStatusLabel}}" Header="Stato" />
                            <DataGridTextColumn Width="90" Binding="{Binding Item.DaneaRef}" Header="Rif. Danea" />
                            <DataGridTextColumn Width="100" Binding="{Binding Item.DateNeeded, StringFormat=dd/MM/yyyy}" Header="Data prev." />
                            <DataGridTextColumn Width="120" Binding="{Binding Item.Destination}" Header="Destinazione" />
                            <DataGridTextColumn Width="200" Binding="{Binding Item.Notes}" Header="Note" />
                            <DataGridTextColumn Width="100" Binding="{Binding Item.UnitCost, StringFormat='€ {0:N2}'}" Header="Costo un." />
                            <DataGridTextColumn Width="110" Binding="{Binding Item.TotalCost, StringFormat='€ {0:N2}'}" Header="Totale" />
                            <DataGridTextColumn Width="80" Binding="{Binding PctLabel}" Header="% tot." />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Destinazioni" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="dest" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="6,8,6,8">
                        <TextBlock x:Name="txtDestSub" Margin="0,0,0,12" FontSize="11.5" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="" />
                        <ItemsControl x:Name="icDest" />
                    </StackPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Dati Mancanti" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="mancanti" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="txtMancantiSub" DockPanel.Dock="Top" Margin="2,0,0,8" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="" />
                        <DataGrid
                            x:Name="dgMancanti"
                            MaxHeight="420"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                        <DataGridTextColumn Width="60" Binding="{Binding RowNo}" Header="Riga" />
                        <DataGridTextColumn Width="150" Binding="{Binding StatoKey, Converter={StaticResource DdpStatusLabel}}" Header="Stato" />
                        <DataGridTextColumn Width="*" MinWidth="180" Binding="{Binding Desc}" Header="Descrizione" />
                        <DataGridTemplateColumn Width="90" Header="Stato">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Stato.Brush}" Text="{Binding Stato.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="110" Header="Rif. Danea">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Rif.Brush}" Text="{Binding Rif.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" Header="Data Prev. Cons.">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Data.Brush}" Text="{Binding Data.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" Header="Destinazione">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Dest.Brush}" Text="{Binding Dest.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="110" Header="Costo Unitario">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Costo.Brush}" Text="{Binding Costo.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Dati Distinta" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="distinta" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <DataGrid
                        x:Name="dgDistinta"
                        MaxHeight="460"
                        Margin="0,6,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="50" Binding="{Binding RowNumber}" Header="#" />
                            <DataGridTextColumn Width="90" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Header="Data" />
                            <DataGridTextColumn Width="110" Binding="{Binding RequestedBy}" Header="Rich." />
                            <DataGridTextColumn Width="120" Binding="{Binding PartNumber}" Header="Codice" />
                            <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Description}" Header="Descrizione" />
                            <DataGridTextColumn Width="60" Binding="{Binding Quantity, StringFormat=0.##}" Header="Qtà" />
                            <DataGridTextColumn Width="50" Binding="{Binding Unit}" Header="UM" />
                            <DataGridTextColumn Width="130" Binding="{Binding SupplierName}" Header="Fornitore" />
                            <DataGridTextColumn Width="120" Binding="{Binding Manufacturer}" Header="Produttore" />
                            <DataGridTextColumn Width="150" Binding="{Binding ItemStatus, Converter={StaticResource DdpStatusLabel}}" Header="Stato" />
                            <DataGridTextColumn Width="90" Binding="{Binding DaneaRef}" Header="Rif. Danea" />
                            <DataGridTextColumn Width="100" Binding="{Binding DateNeeded, StringFormat=dd/MM/yyyy}" Header="Data prev." />
                            <DataGridTextColumn Width="120" Binding="{Binding Destination}" Header="Destinazione" />
                            <DataGridTextColumn Width="200" Binding="{Binding Notes}" Header="Note" />
                            <DataGridTextColumn Width="100" Binding="{Binding UnitCost, StringFormat='€ {0:N2}'}" Header="Costo un." />
                            <DataGridTextColumn Width="110" Binding="{Binding TotalCost, StringFormat='€ {0:N2}'}" Header="Totale" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Feedback Acquisti" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="acq" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="6,8,6,8">
                        <TextBlock x:Name="txtAcqSub" Margin="0,0,0,12" FontSize="11.5" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="" />
                        <ItemsControl x:Name="icAcq" />
                    </StackPanel>
                </Expander>

                <Expander Expanded="Section_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ExpHead}" VerticalAlignment="Center" Text="Feedback Magazzino" />
                            <Button Margin="10,0,0,0" Padding="6,1" Click="PrintSection_Click" Content="🖨 PDF" FontSize="11" Tag="mag" Style="{DynamicResource ShadcnButtonOutline}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="6,8,6,8">
