<Window
    x:Class="ATEC.PM.Client.Views.BudgetVsCosting.ImportPhasesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Importa fasi da template"
    Width="400" Height="350"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            FontSize="12"
            Foreground="#6B7280"
            Text="Seleziona le fasi da aggiungere alla commessa:" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
                Margin="0,0,8,0"
                Padding="16,6"
                Click="BtnOk_Click"
                Content="Importa"
                IsDefault="True"
                Style="{StaticResource PrimaryBtn}" />
            <Button
                Padding="16,6"
                Click="BtnCancel_Click"
                Content="Annulla"
                IsCancel="True"
                Style="{StaticResource SecondaryBtn}" />
        </StackPanel>

        <ListBox
            x:Name="lbTemplates"
            SelectionMode="Multiple"
            BorderThickness="1"
            BorderBrush="{StaticResource Gray200Brush}"
            Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Margin="2"
                        Content="{Binding Name}"
                        FontSize="12"
                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
