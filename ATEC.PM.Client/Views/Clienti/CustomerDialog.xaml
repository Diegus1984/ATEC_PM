<Window
    x:Class="ATEC.PM.Client.Views.CustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cliente"
    Width="480"
    Height="520"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
            <Style x:Key="Inp" TargetType="TextBox" BasedOn="{StaticResource ShadcnTextBox}">
                <Setter Property="Height" Value="32" />
            </Style>
            <Style x:Key="NotesInp" TargetType="TextBox" BasedOn="{StaticResource ShadcnTextBox}">
                <Setter Property="Height" Value="60" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--  BOTTOM BUTTONS  -->
        <Border
            Padding="16,12"
            Background="White"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <TextBlock
                    x:Name="txtError"
                    MaxWidth="240"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnDestructiveBrush}"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Height="34"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonOutline}"
                        IsCancel="True" />
                    <Button
                        x:Name="btnSave"
                        Width="90"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="BtnSave_Click"
                        Content="Salva"
                        Style="{StaticResource ShadcnButtonDefault}"
                        IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  FORM  -->
        <ScrollViewer Padding="24,8,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="RAGIONE SOCIALE *" />
                <TextBox x:Name="txtCompanyName" Style="{StaticResource Inp}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Lbl}" Text="REFERENTE" />
                        <TextBox x:Name="txtContactName" Style="{StaticResource Inp}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Lbl}" Text="P.IVA" />
                        <TextBox x:Name="txtVatNumber" Style="{StaticResource Inp}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Lbl}" Text="EMAIL" />
                        <TextBox x:Name="txtEmail" Style="{StaticResource Inp}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Lbl}" Text="TELEFONO" />
                        <TextBox x:Name="txtPhone" Style="{StaticResource Inp}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Lbl}" Text="INDIRIZZO" />
                <TextBox x:Name="txtAddress" Style="{StaticResource Inp}" />

                <TextBlock Style="{StaticResource Lbl}" Text="NOTE" />
                <TextBox x:Name="txtNotes" Style="{StaticResource NotesInp}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>