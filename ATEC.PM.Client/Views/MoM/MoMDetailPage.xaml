<Page
    x:Class="ATEC.PM.Client.Views.MoM.MoMDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ATEC.PM.Client.Controls"
    xmlns:helpers="clr-namespace:ATEC.PM.Client.Helpers"
    xmlns:local="clr-namespace:ATEC.PM.Client.Views.MoM"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>

        <!--  Brush MoM (stati riga, priorità) centralizzati in /Resources/MoMResources.xaml (merge in App.xaml)  -->
        <Style x:Key="PriorityCombo" TargetType="ComboBox" BasedOn="{StaticResource ShadcnComboBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priorita}" Value="1">
                    <Setter Property="Background" Value="{StaticResource MoMPri1Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priorita}" Value="2">
                    <Setter Property="Background" Value="{StaticResource MoMPri2Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priorita}" Value="3">
                    <Setter Property="Background" Value="{StaticResource MoMPri3Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MomColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Style>

        <Style x:Key="MoMActionTextBox" TargetType="TextBox" BasedOn="{StaticResource ShadcnTextBox}">
            <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="helpers:TextBoxAutoGrowAssist.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="MomSortHeadBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowFlagBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <DockPanel>
        <!--  Header  -->
        <Border
            Padding="14,10"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <Button
                    Margin="0,0,14,0"
                    Click="BtnBack_Click"
                    Content="← Riepilogo"
                    DockPanel.Dock="Left"
                    Style="{DynamicResource ShadcnButtonOutline}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="BtnPrint_Click"
                        Content="🖨 Stampa"
                        Style="{DynamicResource ShadcnButtonOutline}" />
                    <Button
                        Margin="0,0,8,0"
                        Click="BtnExportExcel_Click"
                        Content="Esporta Excel"
                        Style="{DynamicResource ShadcnButtonOutline}" />
                    <Button
                        Click="BtnAddRow_Click"
                        Content="+ Nuova riga"
                        Style="{DynamicResource ShadcnButtonDefault}"
                        ToolTip="Aggiungi riga (Ctrl+N)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="{Binding HeaderTitle}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShadcnPrimaryBrush}"
                        CornerRadius="9">
                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}" Text="{Binding TipoBadge}" />
                    </Border>
                    <TextBlock
                        Margin="16,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="RIUNIONE" />
                    <DatePicker
                        VerticalAlignment="Center"
                        SelectedDate="{Binding MeetingDate, Mode=TwoWay}"
                        SelectedDateChanged="DetailMeetingDate_Changed"
                        Style="{DynamicResource ShadcnDatePickerPickerOnly}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Padding="16,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Pronto" />
        </Border>

        <!--  Tabella righe  -->
        <ScrollViewer
            Padding="12"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <DockPanel HorizontalAlignment="Stretch">
                <!--  Intestazione colonne  -->
                <Border
                    Background="{DynamicResource ShadcnMutedBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="1.15*" MinWidth="90" />
                            <ColumnDefinition Width="1.35*" MinWidth="100" />
                            <ColumnDefinition Width="1.75*" MinWidth="120" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="1.45*" MinWidth="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="btnSortId"
                            Grid.Column="0"
                            Click="ColHeader_Click"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Id"
                            ToolTip="Ordina per numero riga" />
                        <Button
                            x:Name="btnSortAttivita"
                            Grid.Column="1"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Attivita"
                            ToolTip="Ordina per attività" />
                        <Button
                            x:Name="btnSortDescrizione"
                            Grid.Column="2"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Descrizione"
                            ToolTip="Ordina per descrizione" />
                        <Button
                            x:Name="btnSortAzione"
                            Grid.Column="3"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Azione"
                            ToolTip="Ordina per azione" />
                        <Button
                            x:Name="btnSortPriorita"
                            Grid.Column="4"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Priorita"
                            ToolTip="Ordina per priorità" />
                        <Button
                            x:Name="btnSortResponsabile"
                            Grid.Column="5"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="Responsabile"
                            ToolTip="Ordina per responsabile" />
                        <Button
                            x:Name="btnSortDataCheck"
                            Grid.Column="6"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="DataCheck"
                            ToolTip="Ordina per data check" />
                        <Button
                            x:Name="btnSortDataClose"
                            Grid.Column="7"
                            Click="ColHeader_Click"
                            Style="{StaticResource MomSortHeadBtn}"
                            Tag="DataClose"
                            ToolTip="Ordina per data close" />
                        <TextBlock Grid.Column="8" Margin="4,8" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource MomColHead}" Text="" />
                    </Grid>
                </Border>
                <!--  Righe  -->
                <Grid>
                <ItemsControl x:Name="icRows" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MoMActionItemVM}">
                                <Border
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                                    BorderThickness="1,0,1,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource MoMRowDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="STANDBY">
                                                    <Setter Property="Background" Value="{StaticResource MoMRowStandbyBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MoMRowCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="CLOSED">
                                                    <Setter Property="Background" Value="{StaticResource MoMRowClosedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="1.15*" MinWidth="90" />
                                            <ColumnDefinition Width="1.35*" MinWidth="100" />
                                            <ColumnDefinition Width="1.75*" MinWidth="120" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="1.45*" MinWidth="130" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="176" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="6,7,6,6" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="{Binding RowNo}" />
                                            <!--  #7: stato a FORMA (non solo colore): 🚩 critica · ⏸ stand-by · ✅ chiusa  -->
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="{Binding StateGlyph}" ToolTip="Stato riga" />
                                        </StackPanel>

                                        <TextBox
                                            Grid.Column="1"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            KeyDown="ActionItemTextBox_KeyDown"
                                            LostFocus="ActionItemTextBox_LostFocus"
                                            Style="{StaticResource MoMActionTextBox}"
                                            Tag="Attivita"
                                            Text="{Binding Attivita, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="ActionItemTextBox_TextChanged" />

                                        <TextBox
                                            Grid.Column="2"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            KeyDown="ActionItemTextBox_KeyDown"
                                            LostFocus="ActionItemTextBox_LostFocus"
                                            Style="{StaticResource MoMActionTextBox}"
                                            Tag="Descrizione"
                                            Text="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="ActionItemTextBox_TextChanged" />

                                        <TextBox
                                            Grid.Column="3"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            KeyDown="ActionItemTextBox_KeyDown"
                                            LostFocus="ActionItemTextBox_LostFocus"
                                            Style="{StaticResource MoMActionTextBox}"
                                            Tag="Azione"
                                            Text="{Binding Azione, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="ActionItemTextBox_TextChanged" />

                                        <StackPanel Grid.Column="4" Margin="6,6" VerticalAlignment="Top">
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                SelectedValue="{Binding Priorita, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Tag"
                                                SelectionChanged="RowPriority_Changed"
                                                Style="{StaticResource PriorityCombo}">
                                                <ComboBoxItem Content="1"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                <ComboBoxItem Content="2"><ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                <ComboBoxItem Content="3"><ComboBoxItem.Tag><sys:Int32>3</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                            </ComboBox>
                                            <StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Button Click="BtnRowCritica_Click" Content="🚩" Style="{StaticResource RowFlagBtn}" ToolTip="Critica / massima priorità (in testa)" />
                                                <Button Click="BtnRowStandby_Click" Content="⏸" Style="{StaticResource RowFlagBtn}" ToolTip="Stand-by" />
                                            </StackPanel>
                                        </StackPanel>

                                        <controls:MultiSelectLookupCombo
                                            Grid.Column="5"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            ItemsSource="{Binding ResponsiblePool}"
                                            Placeholder="Responsabili..."
                                            SelectedIds="{Binding SelectedResponsibleIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectionChanged="ResponsibleSelection_Changed" />

                                        <DatePicker
                                            Grid.Column="6"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            SelectedDate="{Binding DataCheck, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateChanged="ActionItemDatePicker_SelectedDateChanged"
                                            Style="{DynamicResource ShadcnDatePickerPickerOnly}" />

                                        <DatePicker
                                            Grid.Column="7"
                                            Margin="6,6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            SelectedDate="{Binding DataClose, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateChanged="ActionItemDatePicker_SelectedDateChanged"
                                            Style="{DynamicResource ShadcnDatePickerPickerOnly}" />

                                        <!--  Menu azioni riga (⋮): Conferma (chiudi) + Elimina — stesso pattern di UsersPage  -->
                                        <Button
                                            Grid.Column="8"
                                            Width="28"
                                            Height="28"
                                            Margin="2,5,2,0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Click="BtnRowOptions_Click"
                                            Content="⋮"
                                            FontSize="15"
                                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                            Style="{DynamicResource ShadcnButtonGhost}"
                                            ToolTip="Azioni riga">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{DynamicResource ShadcnContextMenu}">
                                                    <ContextMenu.Resources>
                                                        <!--  Tema SCURO solo per questo menu (come negli Utenti), anche se la pagina è chiara  -->
                                                        <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="#0C0C0E" />
                                                        <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="#FAFAFA" />
                                                        <SolidColorBrush x:Key="ShadcnBorderBrush" Color="#1F1F23" />
                                                        <SolidColorBrush x:Key="ShadcnSecondaryBrush" Color="#18181B" />
                                                        <SolidColorBrush x:Key="ShadcnMutedForegroundBrush" Color="#A1A1AA" />
                                                    </ContextMenu.Resources>
                                                    <MenuItem Click="MenuRowConferma_Click" Header="{Binding ConfermaLabel}" Style="{DynamicResource ShadcnMenuItem}">
                                                        <MenuItem.Icon>
                                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="&#xE73E;" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="BtnRowDelete_Click" Header="Elimina" Style="{DynamicResource ShadcnMenuItem}">
                                                        <MenuItem.Icon>
                                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="&#xE74D;" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--  #2: stato vuoto  -->
                    <TextBlock
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="12"
                        FontStyle="Italic"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="Nessuna azione — premi “+ Nuova riga” (Ctrl+N)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=icRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
