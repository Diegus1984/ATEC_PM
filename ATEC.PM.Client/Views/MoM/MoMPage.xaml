<Page
    x:Class="ATEC.PM.Client.Views.MoM.MoMPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ATEC.PM.Client.Views.MoM"
    MinWidth="900"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Proxy per esporre il DataContext della pagina (Projects) anche dentro i Popup (cartelle)  -->
        <local:BindingProxy x:Key="MomPageProxy" Data="{Binding}" />

        <!--  Label form della card (modifica inline)  -->
        <Style x:Key="MomFormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--  ════════ CARD VERBALE (riusata a top-level e dentro le cartelle) ════════  -->
        <DataTemplate DataType="{x:Type local:MoMVerbaleNode}">
            <Border
                Width="330"
                Margin="0,0,16,16"
                Background="{DynamicResource ShadcnCardBrush}"
                BorderBrush="{DynamicResource ShadcnBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
                <StackPanel>
                    <!--  Accento superiore  -->
                    <Border
                        Height="6"
                        Background="{DynamicResource ShadcnPrimaryBrush}"
                        CornerRadius="10,10,0,0" />

                    <StackPanel Margin="14,12,14,12">
                        <!--  ── Modalità LETTURA ──  -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!--  Corpo card: clic = apri dettaglio  -->
                            <StackPanel
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="Card_Open">
                                <!--  Titolo + badge tipo  -->
                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="220"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                                        Text="{Binding HeaderTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ShadcnPrimaryBrush}"
                                        CornerRadius="9">
                                        <TextBlock
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding TipoBadge}" />
                                    </Border>
                                </StackPanel>

                                <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource ShadcnBorderBrush}" />

                                <Grid Margin="0,2,0,4">
                                    <TextBlock HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Milestones / attività" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="{Binding ItemsCount}" />
                                </Grid>

                                <Grid Margin="0,2,0,4">
                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Ripartizione priorità" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border Margin="0,0,4,0" Padding="7,1" Background="{DynamicResource MoMBadgeP1Bg}" CornerRadius="9">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP1Ink}" Text="{Binding P1Count}" />
                                        </Border>
                                        <Border Margin="0,0,4,0" Padding="7,1" Background="{DynamicResource MoMBadgeP2Bg}" CornerRadius="9">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP2Ink}" Text="{Binding P2Count}" />
                                        </Border>
                                        <Border Padding="7,1" Background="{DynamicResource MoMBadgeP3Bg}" CornerRadius="9">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP3Ink}" Text="{Binding P3Count}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,2,0,4">
                                    <TextBlock HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Periodo attività" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="{Binding PeriodLabel}" />
                                </Grid>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Data riunione" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="{Binding MeetingLabel}" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Margin="0,8,0,8" Background="{DynamicResource ShadcnBorderBrush}" />

                            <!--  Footer azioni: fuori dall'area cliccabile  -->
                            <Grid>
                                <CheckBox
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="DashboardCheck_Click"
                                    Content="dashboard commesse"
                                    FontSize="12"
                                    IsChecked="{Binding InDashboard, Mode=TwoWay}"
                                    Style="{DynamicResource ShadcnCheckBox}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Height="28"
                                        Margin="0,0,6,0"
                                        Padding="12,0"
                                        Click="BtnEditVerbale_Click"
                                        Content="Modifica"
                                        FontSize="12"
                                        Style="{DynamicResource ShadcnButtonOutline}" />
                                    <Button
                                        Height="28"
                                        Padding="12,0"
                                        Background="{DynamicResource ShadcnDestructiveBrush}"
                                        Click="BtnDeleteVerbale_Click"
                                        Content="Elimina"
                                        FontSize="12"
                                        Style="{DynamicResource ShadcnButtonDestructive}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!--  ── Modalità MODIFICA inline ──  -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ShadcnForegroundBrush}"
                                Text="{Binding InlineEditTitle}" />

                            <TextBlock Style="{StaticResource MomFormLabel}" Text="Tipo" />
                            <ComboBox
                                Margin="0,0,0,8"
                                SelectedValue="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Tag"
                                Style="{DynamicResource ShadcnComboBox}">
                                <ComboBoxItem Content="Riunione" Tag="RIUNIONE" />
                                <ComboBoxItem Content="Commessa" Tag="COMMESSA" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource MomFormLabel}" Text="Commessa" />
                            <ComboBox
                                Margin="0,0,0,8"
                                DisplayMemberPath="Display"
                                IsEnabled="{Binding IsCommessa}"
                                ItemsSource="{Binding Data.Projects, Source={StaticResource MomPageProxy}}"
                                SelectedValue="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Id"
                                SelectionChanged="InlineProject_SelectionChanged"
                                Style="{DynamicResource ShadcnComboBox}" />

                            <TextBlock Style="{StaticResource MomFormLabel}" Text="Titolo *" />
                            <TextBox
                                Margin="0,0,0,8"
                                Style="{DynamicResource ShadcnTextBox}"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource MomFormLabel}" Text="Data riunione" />
                            <DatePicker
                                Margin="0,0,0,8"
                                SelectedDate="{Binding MeetingDate, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource ShadcnDatePickerPickerOnly}" />

                            <CheckBox
                                Margin="0,0,0,12"
                                Content="dashboard commesse"
                                FontSize="12"
                                IsChecked="{Binding InDashboard, Mode=TwoWay}"
                                Style="{DynamicResource ShadcnCheckBox}" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Padding="12,0"
                                    Click="BtnInlineCancel_Click"
                                    Content="Annulla"
                                    FontSize="12"
                                    Style="{DynamicResource ShadcnButtonOutline}" />
                                <Button
                                    Height="28"
                                    Padding="12,0"
                                    Click="BtnInlineSave_Click"
                                    Content="Salva"
                                    FontSize="12"
                                    Style="{DynamicResource ShadcnButtonDefault}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  ════════ CARTELLA COMMESSA (2+ verbali) — hover = espande in overlay ════════  -->
        <DataTemplate DataType="{x:Type local:MoMFolderNode}">
            <Grid Width="330" Margin="0,0,16,16">
                <!--  Tile cartella (bordo accento per differenziarla dalle card singole)  -->
                <Border
                    x:Name="folderTile"
                    Background="{DynamicResource ShadcnCardBrush}"
                    BorderBrush="{DynamicResource ShadcnPrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Cursor="Hand"
                    MouseEnter="Folder_MouseEnter"
                    MouseLeave="Folder_MouseLeave"
                    MouseLeftButtonUp="Folder_Click"
                    SnapsToDevicePixels="True">
                    <StackPanel>
                        <Border
                            Height="6"
                            Background="{DynamicResource ShadcnPrimaryBrush}"
                            CornerRadius="10,10,0,0" />

                        <StackPanel Margin="14,12,14,12">
                            <!--  Intestazione cartella  -->
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="18" Text="📁" />
                                <TextBlock
                                    MaxWidth="240"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ShadcnForegroundBrush}"
                                    Text="{Binding HeaderTitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource ShadcnBorderBrush}" />

                            <Grid Margin="0,2,0,4">
                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Verbali" />
                                <Border HorizontalAlignment="Right" Padding="8,1" Background="{DynamicResource ShadcnPrimaryBrush}" CornerRadius="9">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding Count}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <TextBlock HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Attività totali" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ShadcnForegroundBrush}" Text="{Binding ItemsCount}" />
                            </Grid>

                            <Grid Margin="0,2,0,6">
                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ShadcnMutedForegroundBrush}" Text="Ripartizione priorità" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Border Margin="0,0,4,0" Padding="7,1" Background="{DynamicResource MoMBadgeP1Bg}" CornerRadius="9">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP1Ink}" Text="{Binding P1Count}" />
                                    </Border>
                                    <Border Margin="0,0,4,0" Padding="7,1" Background="{DynamicResource MoMBadgeP2Bg}" CornerRadius="9">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP2Ink}" Text="{Binding P2Count}" />
                                    </Border>
                                    <Border Padding="7,1" Background="{DynamicResource MoMBadgeP3Bg}" CornerRadius="9">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MoMBadgeP3Ink}" Text="{Binding P3Count}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!--  Anteprima titoli verbali (come le icone nella cartella)  -->
                            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding PreviewTitles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,1,0,1"
                                            FontSize="12"
                                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11"
                                FontStyle="Italic"
                                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                Text="Passa il mouse per espandere" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Overlay espansione cartella (effetto "apri cartella")  -->
                <Popup
                    AllowsTransparency="True"
                    HorizontalOffset="0"
                    IsOpen="{Binding IsOpen}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=folderTile}"
                    PopupAnimation="Fade"
                    StaysOpen="True"
                    VerticalOffset="2">
                    <Border
                        MaxWidth="720"
                        Margin="6"
                        Background="{DynamicResource ShadcnCardBrush}"
                        BorderBrush="{DynamicResource ShadcnPrimaryBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        MouseEnter="FolderPopup_MouseEnter"
                        MouseLeave="FolderPopup_MouseLeave">
                        <StackPanel Margin="12">
                            <TextBlock
                                Margin="2,0,0,10"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ShadcnForegroundBrush}"
                                Text="{Binding HeaderTitle}" />
                            <ScrollViewer
                                MaxHeight="520"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Verbali}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <DockPanel>
        <!--  Toolbar  -->
        <Border
            Padding="12,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="BtnNewVerbale_Click"
                        Content="+ Nuovo Verbale"
                        Style="{DynamicResource ShadcnButtonDefault}" />
                    <Button
                        Margin="0,0,16,0"
                        Click="BtnRefresh_Click"
                        Content="Aggiorna"
                        Style="{DynamicResource ShadcnButtonOutline}" />
                    <Grid Width="200" VerticalAlignment="Center">
                        <TextBox
                            x:Name="txtSearch"
                            Height="32"
                            Padding="8,0"
                            VerticalContentAlignment="Center"
                            Style="{DynamicResource ShadcnTextBox}"
                            TextChanged="TxtSearch_TextChanged" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            IsHitTestVisible="False"
                            Text="Cerca verbali...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Padding="16,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="Pronto" />
        </Border>

        <!--  VISTA GRIGLIA — cartelle (commesse con 2+ verbali) + card singole  -->
        <ScrollViewer
            x:Name="gridScroll"
            Padding="16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icCards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
