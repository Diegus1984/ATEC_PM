<Window
    x:Class="ATEC.PM.Client.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ATEC PM - Login"
    MinWidth="400"
    MinHeight="480"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border
            Margin="40"
            Padding="32"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.08" ShadowDepth="6" Color="Black" />
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <Border
                    Width="48"
                    Height="48"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ShadcnPrimaryBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                        Text="A" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ShadcnForegroundBrush}"
                    Text="ATEC PM" />
                <TextBlock
                    Margin="0,4,0,28"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="Gestione Commesse" />

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="SERVER" />
                <TextBox
                    x:Name="txtServer"
                    Style="{StaticResource ShadcnTextBox}"
                    Text="https://localhost:5101" />

                <TextBlock
                    Margin="0,16,0,6"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="UTENTE" />
                <TextBox
                    x:Name="txtUsername"
                    Style="{StaticResource ShadcnTextBox}" />

                <TextBlock
                    Margin="0,16,0,6"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="PASSWORD" />
                <Grid>
                    <PasswordBox
                        x:Name="txtPassword"
                        Style="{StaticResource ShadcnPasswordBox}"
                        KeyDown="txtPassword_KeyDown"
                        PasswordChanged="TxtPassword_PasswordChanged" />
                    <TextBox
                        x:Name="txtPasswordVisible"
                        Style="{StaticResource ShadcnTextBox}"
                        KeyDown="txtPassword_KeyDown"
                        Visibility="Collapsed" />
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        PreviewMouseLeftButtonDown="BtnEye_Down"
                        PreviewMouseLeftButtonUp="BtnEye_Up">
                        <TextBlock
                            x:Name="txtEyeIcon"
                            FontSize="16"
                            Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                            Text="👁" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="txtError"
                    Margin="0,12,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnDestructiveBrush}"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="btnLogin"
                    Height="40"
                    Margin="0,20,0,0"
                    Style="{StaticResource ShadcnButtonDefault}"
                    Click="BtnLogin_Click"
                    Content="Accedi"
                    FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
