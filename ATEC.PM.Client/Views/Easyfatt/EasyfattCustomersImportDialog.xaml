<Window
    x:Class="ATEC.PM.Client.Views.EasyfattCustomersImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Importa Clienti da Easyfatt"
    Width="1200"
    Height="700"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Success Button (green) in Shadcn style -->
            <Style x:Key="ShadcnButtonSuccess" BasedOn="{StaticResource ShadcnButtonBase}" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ShadcnSuccessBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnSuccessForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShadcnSuccessBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#059669" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#059669" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#047857" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--  Toolbar  -->
        <Border
            Padding="16,10"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        Text="File .eft:" />
                    <TextBox
                        x:Name="txtFilePath"
                        Width="400"
                        Height="32"
                        Style="{StaticResource ShadcnTextBox}"
                        Text="C:\ATEC_Commesse\Srl-2020-2021.eft" />
                    <Button
                        Margin="8,0,0,0"
                        Height="32"
                        Click="BtnLoad_Click"
                        Content="Carica"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnImport"
                        Height="32"
                        Click="BtnImport_Click"
                        Content="Importa selezionati"
                        IsEnabled="False"
                        Style="{StaticResource ShadcnButtonSuccess}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Filtri e riepilogo  -->
        <Border
            Padding="16,8"
            Background="{DynamicResource ShadcnMutedBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock
                        x:Name="txtSummary"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource ShadcnForegroundBrush}" />
                    <TextBlock
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="  |  Filtra:" />
                    <RadioButton
                        x:Name="rbAll"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Checked="Filter_Changed"
                        Content="Tutti"
                        IsChecked="True" />
                    <RadioButton
                        x:Name="rbNew"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Checked="Filter_Changed"
                        Content="Nuovi" />
                    <RadioButton
                        x:Name="rbDup"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Checked="Filter_Changed"
                        Content="Duplicati" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                        Text="Cerca:" />
                    <TextBox
                        x:Name="txtSearch"
                        Width="200"
                        Height="28"
                        Style="{StaticResource ShadcnTextBox}"
                        TextChanged="TxtSearch_Changed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Padding="16,10"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <TextBlock
                    x:Name="txtStatus"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="Inserire il percorso del file .eft e premere Carica" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Height="30"
                        Padding="12,0"
                        Click="BtnSelectAll_Click"
                        Content="Seleziona tutti"
                        Style="{StaticResource ShadcnButtonOutline}" />
                    <Button
                        Height="30"
                        Margin="6,0,0,0"
                        Padding="12,0"
                        Click="BtnDeselectAll_Click"
                        Content="Deseleziona tutti"
                        Style="{StaticResource ShadcnButtonOutline}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  DataGrid clienti  -->
        <Border
            Margin="16"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.04" ShadowDepth="1" Color="Black" />
            </Border.Effect>

            <DataGrid
                x:Name="dgImport"
                BorderThickness="0"
                IsReadOnly="False"
                Style="{StaticResource ShadcnDataGrid}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ShadcnRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="DUPLICATO">
                                <Setter Property="Background" Value="#FEF9C3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn
                        Width="40"
                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                        Header="Sel." />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="150"
                        Binding="{Binding CompanyName}"
                        Header="Ragione Sociale"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="80"
                        Binding="{Binding ContactName}"
                        Header="Referente"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        MinWidth="100"
                        Binding="{Binding Email}"
                        Header="Email"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        MinWidth="100"
                        Binding="{Binding Pec}"
                        Header="PEC"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="80"
                        Binding="{Binding Phone}"
                        Header="Tel"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="80"
                        Binding="{Binding Cell}"
                        Header="Cell"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="90"
                        Binding="{Binding VatNumber}"
                        Header="P.IVA"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="80"
                        Binding="{Binding FiscalCode}"
                        Header="C.F."
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="80"
                        MinWidth="60"
                        Binding="{Binding SdiCode}"
                        Header="SDI"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="80"
                        MinWidth="60"
                        Binding="{Binding Status}"
                        Header="Stato"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="140"
                        MinWidth="100"
                        Binding="{Binding ExistingName}"
                        Header="Esistente come"
                        IsReadOnly="True" />
                    <DataGridComboBoxColumn
                        Width="90"
                        Header="Azione"
                        SelectedValueBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:String">
                                <sys:String>INSERT</sys:String>
                                <sys:String>UPDATE</sys:String>
                                <sys:String>SKIP</sys:String>
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
