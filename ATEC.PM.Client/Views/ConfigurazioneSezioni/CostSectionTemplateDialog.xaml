<Window
    x:Class="ATEC.PM.Client.Views.CostSectionTemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nuova Sezione Costo"
    Width="500"
    Height="520"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ToggleSwitchStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnPrimaryBrush}"
            DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                    Text="Nuova sezione costo" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                    Opacity="0.85"
                    Text="Definisci nome, gruppo, tipo e reparti di pertinenza" />
            </StackPanel>
        </Border>
        <Border
            Padding="16,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <TextBlock
                    x:Name="txtError"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnDestructiveBrush}"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonSecondary}" />
                    <Button
                        Width="90"
                        Margin="8,0,0,0"
                        Click="BtnSave_Click"
                        Content="Salva"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Padding="24,8,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Lbl}" Text="NOME SEZIONE *" />
                <TextBox x:Name="txtName" Style="{StaticResource ShadcnTextBox}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Lbl}" Text="TIPO *" />
                        <ComboBox x:Name="cmbType" Style="{StaticResource ShadcnComboBox}">
                            <ComboBoxItem Content="IN_SEDE" IsSelected="True" />
                            <ComboBoxItem Content="DA_CLIENTE" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Lbl}" Text="GRUPPO *" />
                        <ComboBox x:Name="cmbGroup" Style="{StaticResource ShadcnComboBox}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Lbl}" Text="ORDINAMENTO" />
                        <TextBox x:Name="txtSortOrder" Style="{StaticResource ShadcnTextBox}" Text="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Lbl}" Text="INCLUDI DI DEFAULT" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <CheckBox x:Name="chkDefaultProject" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource ShadcnForegroundBrush}"
                                Text="Commessa" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <CheckBox x:Name="chkDefaultQuote" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource ShadcnForegroundBrush}"
                                Text="Preventivo" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Lbl}" Text="REPARTI DI PERTINENZA" />
                <Border
                    Padding="12,8"
                    Background="{DynamicResource ShadcnBackgroundBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <WrapPanel x:Name="wpDepartments" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
