<Window
    x:Class="ATEC.PM.Client.Views.SectionTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tipo sezione"
    Width="400"
    SizeToContent="Height"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock
            DockPanel.Dock="Top"
            Margin="0,0,0,12"
            Style="{StaticResource ShadcnMuted}"
            Text="Scegli il tipo della nuova sezione costo" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button
                Width="90"
                Click="BtnCancel_Click"
                Content="Annulla"
                IsCancel="True"
                Style="{StaticResource ShadcnButtonSecondary}" />
            <Button
                Width="90"
                Margin="8,0,0,0"
                Click="BtnOk_Click"
                Content="Continua"
                IsDefault="True"
                Style="{StaticResource ShadcnButtonDefault}" />
        </StackPanel>
        <ComboBox x:Name="cmbType" Style="{StaticResource ShadcnComboBox}">
            <ComboBoxItem Content="IN_SEDE" IsSelected="True" />
            <ComboBoxItem Content="DA_CLIENTE" />
        </ComboBox>
    </DockPanel>
</Window>
