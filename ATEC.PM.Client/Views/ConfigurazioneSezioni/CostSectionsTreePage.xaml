<Page
    x:Class="ATEC.PM.Client.Views.CostSectionsTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}">

    <!-- Preset: https://ui.shadcn.com/create?preset=bIkeymG (zinc, sidebar scura, card chiare) -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SidebarBgBrush" Color="#09090B" />
            <SolidColorBrush x:Key="SidebarFgBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="SidebarMutedBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#27272A" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#18181B" />
            <SolidColorBrush x:Key="SidebarAccentBrush" Color="#27272A" />

            <Style x:Key="PanelSectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
            </Style>

            <Style x:Key="SidebarSectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
            </Style>

            <Style x:Key="DragBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <DockPanel Margin="0">

        <!-- Toolbar -->
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource ShadcnH2}" Text="Sezioni costo" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource ShadcnMuted}"
                        Text="Configura gruppi, sezioni, fasi e collegamenti ai reparti" />
                    <TextBlock
                        x:Name="txtCount"
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource ShadcnMutedForegroundBrush}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnAddGroup_Click"
                        Content="+ Gruppo"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border
            Padding="20,8"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="txtStatus"
                FontSize="12"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}" />
        </Border>

        <!-- Main -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Reparti (sidebar stile preset / dashboard Shadcn) -->
            <Border
                Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <DockPanel>
                    <Border
                        Padding="16,12"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <DockPanel>
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="BtnAddDepartment_Click"
                                Content="+"
                                DockPanel.Dock="Right"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Style="{StaticResource ShadcnButtonGhost}"
                                Foreground="{StaticResource SidebarFgBrush}"
                                ToolTip="Nuovo reparto" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource SidebarSectionLabel}"
                                    Text="REPARTI" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SidebarFgBrush}"
                                    Text="Trascina su una sezione" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer
                        Padding="8,8,8,12"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlDepartments" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource ShadcnBorderBrush}" />

            <!-- Struttura sezioni + fasi -->
            <Border
                Grid.Column="2"
                Padding="0"
                Style="{StaticResource ShadcnCard}">
                <DockPanel>
                    <Border
                        Padding="0,0,0,12"
                        BorderBrush="{DynamicResource ShadcnBorderBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource PanelSectionLabel}"
                                Text="STRUTTURA" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource ShadcnH3}"
                                Text="Gruppi, sezioni e fasi" />
                        </StackPanel>
                    </Border>
                    <TreeView
                        x:Name="tvSections"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderThickness="0"
                        DragOver="TvSections_DragOver"
                        Drop="TvSections_Drop"
                        FontSize="13"
                        Padding="4,8,4,4"
                        Style="{StaticResource ShadcnTreeView}">
                        <TreeView.Resources>
                            <Style BasedOn="{StaticResource ShadcnTreeViewItem}" TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Page>
