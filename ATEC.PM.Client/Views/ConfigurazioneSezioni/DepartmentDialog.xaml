<Window
    x:Class="ATEC.PM.Client.Views.DepartmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reparto"
    Width="440"
    SizeToContent="Height"
    MinHeight="400"
    Background="{DynamicResource ShadcnMutedBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnPrimaryBrush}"
            DockPanel.Dock="Top">
            <TextBlock
                x:Name="txtDialogTitle"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                Text="Nuovo Reparto" />
        </Border>
        <Border
            Padding="16,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel>
                <TextBlock
                    x:Name="txtError"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnDestructiveBrush}"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonSecondary}" />
                    <Button
                        Width="90"
                        Margin="8,0,0,0"
                        Click="BtnSave_Click"
                        Content="Salva"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="24,8,24,16">
            <TextBlock Style="{StaticResource Lbl}" Text="CODICE *" />
            <TextBox
                x:Name="txtCode"
                CharacterCasing="Upper"
                MaxLength="10"
                Style="{StaticResource ShadcnTextBox}" />
            <TextBlock Style="{StaticResource Lbl}" Text="NOME *" />
            <TextBox x:Name="txtName" Style="{StaticResource ShadcnTextBox}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="COSTO ORARIO €" />
                    <TextBox x:Name="txtHourlyCost" Style="{StaticResource ShadcnTextBox}" Text="0.00" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="K RICARICO" />
                    <TextBox x:Name="txtDefaultMarkup" Style="{StaticResource ShadcnTextBox}" Text="1.450" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Lbl}" Text="ORDINE" />
            <TextBox x:Name="txtSortOrder" Style="{StaticResource ShadcnTextBox}" Text="0" />
        </StackPanel>
    </DockPanel>
</Window>
