<Window
    x:Class="ATEC.PM.Client.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ATEC PM - Gestione Commesse"
    Width="1920"
    Height="1080"
    MinWidth="1024"
    MinHeight="600"
    Background="#FAFAFB"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Merge the complete Shadcn/UI Style Library -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 
                ===================================================================
                SHADCN DARK SIDEBAR COLORS & BRUSHES (SPECIFIC TO SIDEBAR)
                ===================================================================
            -->
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#09090B" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1F1F23" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#71717A" />
            <SolidColorBrush x:Key="SidebarHoverBgBrush" Color="#18181B" />
            <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#18181B" />
            <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="#FFFFFF" />

            <!-- ProfileContextMenuStyle (Dark Theme Popover) -->
            <Style x:Key="ProfileContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource SidebarBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.3" ShadowDepth="3" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style for Profile Menu Items (Dark Theme ContextMenu Items) -->
            <Style x:Key="ProfileMenuItemStyle" TargetType="MenuItem">
                <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#A1A1AA" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="bd"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Margin="4,2"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="IconGroup" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <ContentPresenter x:Name="IconPresenter"
                                                      Grid.Column="0"
                                                      ContentSource="Icon"
                                                      Margin="10,0,10,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />

                                    <!-- Content (Text) -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#4B4B52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProfileMenuSeparatorStyle" TargetType="Separator">
                <Setter Property="Background" Value="#1F1F23" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style for Profile Menu Header (User Information card inside popup) -->
            <Style x:Key="ProfileMenuHeaderStyle" TargetType="MenuItem">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border Padding="12,10,12,8" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials Avatar inside popup -->
                                    <Border Grid.Column="0" Style="{StaticResource ShadcnAvatar}" Width="32" Height="32" CornerRadius="16">
                                        <TextBlock Text="{Binding Path=PlacementTarget.DataContext.UserInitials, RelativeSource={RelativeSource AncestorType=ContextMenu}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarActiveTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name and Role -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path=PlacementTarget.DataContext.UserFullName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarActiveTextBrush}" />
                                        <TextBlock Text="{Binding Path=PlacementTarget.DataContext.UserRole, RelativeSource={RelativeSource AncestorType=ContextMenu}}" FontSize="10.5" Foreground="{DynamicResource SidebarMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Stile gruppo navigazione sidebar (Expander) -->
            <Style x:Key="NavExpander" TargetType="Expander">
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton
                                    x:Name="HeaderSite"
                                    Margin="12,0,12,2"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource SidebarMutedTextBrush}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Chevron arrow -->
                                                    <Path x:Name="arrow"
                                                          Data="M 0,0 L 3.5,3.5 L 7,0"
                                                          Stroke="{DynamicResource SidebarMutedTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          DockPanel.Dock="Right"
                                                          Margin="8,0,0,0">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="270" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="arrow"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="360" Duration="0:0:0.5">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuinticEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="arrow"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="270" Duration="0:0:0.4">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuinticEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}" />
                                                    <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource SidebarActiveTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Icon wrapped in a rounded square border -->
                                        <Border Width="24" Height="24"
                                                BorderBrush="#27272A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Background="#18181B"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarActiveTextBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </Border>
                                        <!-- Header Text -->
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"
                                            Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Grid x:Name="ExpandSite" Visibility="Collapsed" Margin="0,0,0,4">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform ScaleY="0" />
                                    </Grid.LayoutTransform>
                                    <!-- Vertical Guide Line aligned with center of group icon boxes -->
                                    <Border Width="1" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Stretch"
                                            Background="#27272A" 
                                            Margin="32,2,0,2" />
                                    
                                    <!-- Content (Sub-items) -->
                                    <ContentPresenter />
                                </Grid>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandSite"
                                                                             Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                                 Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                                 Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                                 To="0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuinticEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandSite"
                                                                             Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- NavBtn: Shadcn style sidebar menu button -->
            <Style x:Key="NavBtn" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="54,0,16,0" />
                <Setter Property="FontFamily" Value="{DynamicResource ShadcnFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="12,1,12,1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="cp" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                                </Trigger>
                                <!-- Active item: IsEnabled=False in code-behind -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarActiveBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Icon button per l'header (hamburger, bell) -->
            <Style x:Key="HeaderIconBtn" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShadcnSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Layout Grid: Full Height Sidebar on Column 0, Main Content on Column 1 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colDrawer" Width="280" /> <!-- Aperto di default -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================================
             SIDEBAR (Colonna 0) — Dark Premium Shadcn Theme
             =================================================================== -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True">
            <DockPanel Width="280">

                <!-- WORKSPACE SWITCHER HEADER (Top) -->
                <Border
                    DockPanel.Dock="Top"
                    Background="Transparent"
                    Margin="12,12,12,4">
                    <Border
                        Padding="8,6"
                        CornerRadius="6"
                        Cursor="Hand"
                        Background="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBgBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Blue Logo Icon -->
                            <Border Grid.Column="0"
                                    Width="30" Height="30"
                                    Background="#2563EB"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <TextBlock
                                    Text="A"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- Brand Text -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="ATEC PM"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SidebarActiveTextBrush}" />
                                <TextBlock
                                    Text="Enterprise"
                                    FontSize="10"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource SidebarMutedTextBrush}" />
                            </StackPanel>

                            <!-- Up Down Chevron -->
                            <Path Grid.Column="2"
                                  Data="M 0,2 L 3,0 L 6,2 M 0,6 L 3,8 L 6,6"
                                  Stroke="{DynamicResource SidebarMutedTextBrush}"
                                  StrokeThickness="1.2"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>
                    </Border>
                </Border>

                <!-- USER INFO FOOTER (Bottom) -->
                <Border
                    DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="Transparent">
                    <Border
                        Margin="8,8,8,8"
                        Padding="8,6"
                        CornerRadius="6"
                        Cursor="Hand"
                        Background="Transparent"
                        MouseLeftButtonDown="UserProfileBox_MouseLeftButtonDown"
                        x:Name="userProfileBox">
                        <Border.ContextMenu>
                            <ContextMenu Style="{DynamicResource ProfileContextMenuStyle}">
                                <MenuItem Style="{DynamicResource ProfileMenuHeaderStyle}" />
                                <Separator Style="{DynamicResource ProfileMenuSeparatorStyle}" />
                                
                                <MenuItem Header="Account" Style="{DynamicResource ProfileMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <MenuItem Header="Assistenza" Style="{DynamicResource ProfileMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <Separator Style="{DynamicResource ProfileMenuSeparatorStyle}" />
                                
                                <MenuItem Header="Disconnetti" Click="LogoutMenu_Click" Style="{DynamicResource ProfileMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                
                                <MenuItem Header="Esci dall'app" Click="ExitMenu_Click" Style="{DynamicResource ProfileMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBgBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Initials Avatar -->
                            <Border Grid.Column="0" Style="{StaticResource ShadcnAvatar}" x:Name="avatarBorder">
                                <TextBlock x:Name="txtInitials" Text="DP" />
                            </Border>

                            <!-- Name and Role -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="txtUserName"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SidebarActiveTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="txtRole"
                                    FontSize="11"
                                    FontFamily="{DynamicResource ShadcnFontFamily}"
                                    Margin="0,1,0,0"
                                    Foreground="{DynamicResource SidebarMutedTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Up Down Chevron -->
                            <Path Grid.Column="2"
                                  Data="M 0,2 L 3,0 L 6,2 M 0,6 L 3,8 L 6,6"
                                  Stroke="{DynamicResource SidebarMutedTextBrush}"
                                  StrokeThickness="1.2"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>
                    </Border>
                </Border>

                <!-- SECTION HEADER (Static "PIATTAFORMA") -->
                <Border
                    DockPanel.Dock="Top"
                    Padding="20,12,20,4">
                    <TextBlock
                        Text="PIATTAFORMA"
                        FontSize="10"
                        FontFamily="{DynamicResource ShadcnFontFamily}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource SidebarMutedTextBrush}" />
                </Border>

                <!-- MENU NAVIGAZIONE (con Scrollbar sottile) -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="navMenuPanel" Margin="0,0,0,16" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================================================================
             MAIN AREA (Colonna 1) — Light Content & Header
             =================================================================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- HEADER (48px) — Clean White Layout -->
            <Border
                DockPanel.Dock="Top"
                Height="48"
                Background="White"
                BorderBrush="{DynamicResource ShadcnBorderBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel VerticalAlignment="Stretch" Margin="12,0">

                    <!-- Hamburger Button -->
                    <Button
                        x:Name="btnHamburger"
                        DockPanel.Dock="Left"
                        Click="HamburgerButton_Click"
                        Style="{StaticResource HeaderIconBtn}"
                        VerticalAlignment="Center"
                        ToolTip="Menu">
                        <TextBlock
                            Text="&#xE700;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16" />
                    </Button>

                    <!-- Separator -->
                    <Border
                        DockPanel.Dock="Left"
                        Width="1" Height="16"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShadcnBorderBrush}" />

                    <!-- Current Page Title -->
                    <TextBlock
                        x:Name="txtPageTitle"
                        Text="Dashboard"
                        FontSize="13.5"
                        FontFamily="{DynamicResource ShadcnFontFamily}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShadcnForegroundBrush}"
                        VerticalAlignment="Center" />

                    <!-- Right Bell Notification Button -->
                    <Button
                        x:Name="btnNotif"
                        DockPanel.Dock="Right"
                        Style="{StaticResource HeaderIconBtn}"
                        VerticalAlignment="Center"
                        ToolTip="Notifiche">
                        <Grid>
                            <TextBlock
                                Text="&#xE7E7;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="badgeNotif"
                                Height="14"
                                MinWidth="14"
                                Padding="3,0"
                                Margin="4,-4,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ShadcnDestructiveBrush}"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="txtBadgeCount"
                                    Text="0"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource ShadcnDestructiveForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Page Content Frame -->
            <Frame
                x:Name="PageContent"
                Margin="0"
