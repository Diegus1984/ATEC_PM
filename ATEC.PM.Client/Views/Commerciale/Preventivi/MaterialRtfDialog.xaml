<Window
    x:Class="ATEC.PM.Client.Views.Commerciale.Preventivi.MaterialRtfDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="clr-namespace:ATEC.PM.Client.UserControls"
    Title="Modifica descrizione prodotto"
    Width="900"
    Height="650"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="txtTitle"
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#1A1D26" />

        <uc:HtmlEditor x:Name="htmlEditor" Grid.Row="1" />

        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Height="32"
                Margin="0,0,8,0"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Click="BtnCancel_Click"
                Content="Annulla"
                Cursor="Hand"
                Foreground="#374151" />
            <Button
                Width="90"
                Height="32"
                Background="#2563EB"
                BorderThickness="0"
                Click="BtnSave_Click"
                Content="Salva"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
