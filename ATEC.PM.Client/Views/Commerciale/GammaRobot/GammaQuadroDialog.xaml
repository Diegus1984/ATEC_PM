<Window
    x:Class="ATEC.PM.Client.Views.Commerciale.GammaRobot.GammaQuadroDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quadro"
    Width="440"
    Height="430"
    Background="#F7F8FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#E4E7EC" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <DockPanel>

        <!--  HEADER  -->
        <Border
            Padding="20,14"
            Background="#1A1D26"
            DockPanel.Dock="Top">
            <TextBlock
                x:Name="txtTitle"
                FontSize="15"
                FontWeight="Bold"
                Foreground="White"
                Text="Nuovo quadro" />
        </Border>

        <!--  BUTTONS  -->
        <Border
            Padding="20,10"
            Background="White"
            BorderBrush="#E4E7EC"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Height="32"
                    Background="#F3F4F6"
                    BorderThickness="0"
                    Click="BtnCancel_Click"
                    Content="Annulla"
                    Cursor="Hand"
                    FontSize="13" />
                <Button
                    Width="90"
                    Height="32"
                    Margin="8,0,0,0"
                    Background="#4F6EF7"
                    BorderThickness="0"
                    Click="BtnOk_Click"
                    Content="Salva"
                    Cursor="Hand"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <!--  FORM  -->
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Style="{StaticResource Lbl}" Text="CONTROLLORE" />
                <TextBox x:Name="txtControllore" Style="{StaticResource Fld}" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Style="{StaticResource Lbl}" Text="GENERAZIONE" />
                <TextBox x:Name="txtGenerazione" Style="{StaticResource Fld}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Style="{StaticResource Lbl}" Text="PAYLOAD (kg)" />
                <TextBox x:Name="txtPayload" Style="{StaticResource Fld}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Style="{StaticResource Lbl}" Text="AREA LAVORO (m)" />
                <TextBox x:Name="txtArea" Style="{StaticResource Fld}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0">
                <TextBlock Style="{StaticResource Lbl}" Text="OS VERSION" />
                <TextBox x:Name="txtOsVersion" Style="{StaticResource Fld}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock Style="{StaticResource Lbl}" Text="SYSTEM KEY" />
                <TextBox x:Name="txtSystemKey" Style="{StaticResource Fld}" />
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource Lbl}" Text="NOTE" />
                <TextBox x:Name="txtNote" Style="{StaticResource Fld}" />
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>
