<Page
    x:Class="ATEC.PM.Client.Views.Commerciale.GammaRobot.GammaRobotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F7F8FA">

    <Page.Resources>
        <!--  Cella prezzo allineata a destra  -->
        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!--  Tab in alto (flat, bottom border su attivo gestito in code-behind via Tag)  -->
        <Style x:Key="GammaTab" TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <DockPanel>

        <!--  ══════════════════════════════════════════  -->
        <!--  TAB BAR  -->
        <!--  ══════════════════════════════════════════  -->
        <Border
            Background="White"
            BorderBrush="#E4E7EC"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="tabRobot"
                    Click="TabRobot_Click"
                    Content="Per Robot"
                    Style="{StaticResource GammaTab}" />
                <Button
                    x:Name="tabMagazzino"
                    Click="TabMagazzino_Click"
                    Content="Magazzino (per componente)"
                    Style="{StaticResource GammaTab}" />
                <Button
                    x:Name="tabComposizione"
                    Click="TabComposizione_Click"
                    Content="Composizione"
                    Style="{StaticResource GammaTab}" />
            </StackPanel>
        </Border>

        <Grid>

            <!--  ══════════════════════════════════════════  -->
            <!--  VISTA 1: PER ROBOT  (Robot → Quadro → distinta)  -->
            <!--  ══════════════════════════════════════════  -->
            <Grid x:Name="viewRobot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220" MaxWidth="600" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="#E4E7EC"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext" />

                <!--  Albero Robot → Quadro  -->
                <Border
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border
                            Padding="8,8"
                            Background="#F0F4FF"
                            BorderBrush="#E4E7EC"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#4F6EF7"
                                    Text="ROBOT" />
                                <Button
                                    x:Name="btnRefresh"
                                    HorizontalAlignment="Right"
                                    Padding="8,3"
                                    Background="#F3F4F6"
                                    BorderThickness="0"
                                    Click="BtnRefresh_Click"
                                    Content="⟳"
                                    DockPanel.Dock="Right"
                                    Foreground="#374151"
                                    ToolTip="Aggiorna" />
                            </DockPanel>
                        </Border>

                        <Border
                            Padding="8,8"
                            BorderBrush="#E4E7EC"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid>
                                <TextBox
                                    x:Name="txtSearch"
                                    Height="28"
                                    Padding="8,4"
                                    BorderBrush="#E4E7EC"
                                    FontSize="12"
                                    TextChanged="TxtSearch_TextChanged" />
                                <TextBlock
                                    x:Name="txtSearchPlaceholder"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#9CA3AF"
                                    IsHitTestVisible="False"
                                    Text="Cerca robot..." />
                            </Grid>
                        </Border>

                        <Border
                            Padding="12,6"
                            BorderBrush="#E4E7EC"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <TextBlock
                                x:Name="txtTreeStatus"
                                FontSize="11"
                                Foreground="#9CA3AF"
                                Text="Caricamento..." />
                        </Border>

                        <TreeView
                            x:Name="treeRobot"
                            Padding="4"
                            Background="White"
                            BorderThickness="0"
                            SelectedItemChanged="TreeRobot_SelectedItemChanged" />
                    </DockPanel>
                </Border>

                <!--  Dettaglio quadro + distinta  -->
                <DockPanel Grid.Column="2">
                    <Border
                        Padding="16,12"
                        Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock
                                x:Name="txtHeaderTitle"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#111827"
                                Text="Seleziona un quadro" />
                            <TextBlock
                                x:Name="txtHeaderSub"
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="#6B7280"
                                Text="Scegli un robot e una sua configurazione dall'albero a sinistra." />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16,8"
                        Background="#F9FAFB"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <DockPanel>
                            <TextBlock
                                x:Name="txtFooterCount"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#6B7280"
                                Text="" />
                            <TextBlock
                                x:Name="txtFooterTotal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#111827"
                                Text="" />
                        </DockPanel>
                    </Border>

                    <DataGrid
                        x:Name="dgDistinta"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#E5E7EB"
                        IsReadOnly="True"
                        MouseDoubleClick="DgDistinta_MouseDoubleClick"
                        RowDetailsVisibilityMode="VisibleWhenSelected"
                        RowHeight="28"
                        SelectionMode="Single">
                        <!--  Alternative annidate sotto il principale (visibili quando la riga è selezionata)  -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ItemsControl Background="#FBFBFD" ItemsSource="{Binding Alternatives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="40,2,0,2"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="DistintaAltRow_MouseLeftButtonDown"
                                                ToolTip="Doppio click per aprire la scheda prodotto (catalogo)">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Padding="5,1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="#FEF3C7">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#D97706"
                                                        Text="ALT" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#2563EB"
                                                    Text="{Binding ProductCode}"
                                                    TextDecorations="Underline" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#374151"
                                                    Text="{Binding ProductName}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#6B7280"
                                                    Text="{Binding PrezzoVb, StringFormat={}{0:N2} €}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,4"
                                            Background="#EEF2FF"
                                            BorderBrush="#E4E7EC"
                                            BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#1B3A5C"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#6B7280"
                                                    Text="{Binding ItemCount, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Slot}"
                                Header="Slot" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding ProductCode}"
                                Header="Codice" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ProductName}"
                                Header="Descrizione" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding AltLabel}"
                                Header="Alt."
                                FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D97706" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding OptLabel}"
                                FontWeight="SemiBold"
                                Header="Opz.">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#7C3AED" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="10" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding PrezzoVb, StringFormat={}{0:N2} €}"
                                ElementStyle="{StaticResource RightAlignCell}"
                                Header="Prezzo VB" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!--  ══════════════════════════════════════════  -->
            <!--  VISTA 2: MAGAZZINO  (componente → dove entra)  -->
            <!--  ══════════════════════════════════════════  -->
            <Grid x:Name="viewMagazzino" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="#E4E7EC"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext" />

                <!--  Elenco componenti  -->
                <DockPanel Grid.Column="0">
                    <Border
                        Padding="8,8"
                        Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <Grid>
                            <TextBox
                                x:Name="txtCompSearch"
                                Height="28"
                                Padding="8,4"
                                BorderBrush="#E4E7EC"
                                FontSize="12"
                                TextChanged="TxtCompSearch_TextChanged" />
                            <TextBlock
                                x:Name="txtCompSearchPlaceholder"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#9CA3AF"
                                IsHitTestVisible="False"
                                Text="Cerca componente (codice o descrizione)..." />
                        </Grid>
                    </Border>

                    <Border
                        Padding="12,6"
                        Background="#F9FAFB"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <TextBlock
                            x:Name="txtCompStatus"
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="Caricamento..." />
                    </Border>

                    <DataGrid
                        x:Name="dgComponents"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#E5E7EB"
                        IsReadOnly="True"
                        MouseDoubleClick="DgComponents_MouseDoubleClick"
                        RowHeight="28"
                        SelectionChanged="DgComponents_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding Code}"
                                Header="Codice" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Descrizione" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Categoria}"
                                Header="Categoria" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding RobotCount}"
                                ElementStyle="{StaticResource RightAlignCell}"
                                Header="Robot" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding PrezzoVb, StringFormat={}{0:N2} €}"
                                ElementStyle="{StaticResource RightAlignCell}"
                                Header="Prezzo VB" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!--  Dove entra (usage)  -->
                <Border
                    Grid.Column="2"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border
                            Padding="12,10"
                            BorderBrush="#E4E7EC"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <StackPanel>
                                <TextBlock
                                    x:Name="txtUsageTitle"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"
                                    Text="Dove entra" />
                                <TextBlock
                                    x:Name="txtUsageSub"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="#6B7280"
                                    Text="Seleziona un componente per vedere in quali robot/quadri entra." />
                            </StackPanel>
                        </Border>

                        <DataGrid
                            x:Name="dgUsage"
                            AutoGenerateColumns="False"
                            Background="White"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#E5E7EB"
                            IsReadOnly="True"
                            RowHeight="28"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Modello}"
                                    Header="Robot" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Controllore}"
                                    Header="Quadro" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Slot}"
                                    Header="Slot" />
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Occorrenze}"
                                    ElementStyle="{StaticResource RightAlignCell}"
                                    Header="Conf."
                                    ToolTipService.ToolTip="Numero di configurazioni (varianti payload/area)" />
                                <DataGridTemplateColumn Width="50" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,4"
                                                Padding="5,1"
                                                HorizontalAlignment="Left"
                                                Background="#FEF3C7"
                                                Visibility="{Binding IsAlternate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="#D97706"
                                                    Text="ALT" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!--  ══════════════════════════════════════════  -->
            <!--  VISTA 3: COMPOSIZIONE  (editor distinta drag&drop, solo ADMIN)  -->
            <!--  ══════════════════════════════════════════  -->
            <Grid x:Name="viewComposizione" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="640" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="#E4E7EC"
                    Cursor="SizeWE"
                    ResizeBehavior="PreviousAndNext" />

                <!--  SX: albero robot/quadro (alto) + componenti disponibili (basso)  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!--  SX-ALTO: Robot → Quadro + toolbar ADMIN  -->
                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border
                                Padding="8,8"
                                Background="#F0F4FF"
                                BorderBrush="#E4E7EC"
                                BorderThickness="0,0,0,1"
                                DockPanel.Dock="Top">
                                <DockPanel>
                                    <TextBlock
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#4F6EF7"
                                        Text="ROBOT / QUADRI" />
                                    <StackPanel
                                        x:Name="pnlEditorToolbar"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <Button
                                            x:Name="btnAddRobot"
                                            Margin="0,0,4,0"
                                            Padding="6,3"
                                            Background="#EEF2FF"
                                            BorderThickness="0"
                                            Click="BtnAddRobot_Click"
                                            Content="+ Robot"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="#4F6EF7"
                                            ToolTip="Nuovo robot" />
                                        <Button
                                            x:Name="btnAddQuadro"
                                            Margin="0,0,4,0"
                                            Padding="6,3"
                                            Background="#EEF2FF"
                                            BorderThickness="0"
                                            Click="BtnAddQuadro_Click"
                                            Content="+ Quadro"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="#4F6EF7"
                                            ToolTip="Nuovo quadro sul robot selezionato" />
                                        <Button
                                            x:Name="btnEditNode"
                                            Margin="0,0,4,0"
                                            Padding="6,3"
                                            Background="#F3F4F6"
                                            BorderThickness="0"
                                            Click="BtnEditNode_Click"
                                            Content="✏"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="#374151"
                                            ToolTip="Modifica robot/quadro selezionato" />
                                        <Button
                                            x:Name="btnDeleteNode"
                                            Padding="6,3"
                                            Background="#FEF2F2"
                                            BorderThickness="0"
                                            Click="BtnDeleteNode_Click"
                                            Content="🗑"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Foreground="#EF4444"
                                            ToolTip="Elimina robot/quadro selezionato" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border
                                Padding="8,8"
                                BorderBrush="#E4E7EC"
                                BorderThickness="0,0,0,1"
                                DockPanel.Dock="Top">
                                <Grid>
                                    <TextBox
                                        x:Name="txtEditorSearch"
                                        Height="28"
                                        Padding="8,4"
                                        BorderBrush="#E4E7EC"
                                        FontSize="12"
                                        TextChanged="TxtEditorSearch_TextChanged" />
                                    <TextBlock
                                        x:Name="txtEditorSearchPlaceholder"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#9CA3AF"
                                        IsHitTestVisible="False"
                                        Text="Cerca robot..." />
                                </Grid>
                            </Border>

                            <Border
                                Padding="12,6"
                                BorderBrush="#E4E7EC"
                                BorderThickness="0,1,0,0"
                                DockPanel.Dock="Bottom">
                                <TextBlock
                                    x:Name="txtEditorTreeStatus"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="" />
                            </Border>

                            <TreeView
                                x:Name="treeQuadriEditor"
                                Padding="4"
                                Background="White"
                                BorderThickness="0"
                                SelectedItemChanged="TreeQuadriEditor_SelectedItemChanged" />
                        </DockPanel>
                    </Border>

                    <GridSplitter
                        Grid.Row="1"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#E4E7EC"
                        Cursor="SizeNS"
                        ResizeDirection="Rows" />

                    <!--  SX-BASSO: componenti disponibili (drag source)  -->
                    <Border
                        Grid.Row="2"
                        Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border
                                Padding="8,8"
                                Background="#FFF8F0"
                                BorderBrush="#E4E7EC"
                                BorderThickness="0,0,0,1"
                                DockPanel.Dock="Top">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#D97706"
                                        Text="COMPONENTI DISPONIBILI" />
                                    <Grid Margin="0,6,0,0">
                                        <TextBox
                                            x:Name="txtEditorCompSearch"
                                            Height="28"
                                            Padding="8,4"
                                            BorderBrush="#E4E7EC"
                                            FontSize="12"
                                            TextChanged="TxtEditorCompSearch_TextChanged" />
                                        <TextBlock
                                            x:Name="txtEditorCompSearchPlaceholder"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            IsHitTestVisible="False"
                                            Text="Cerca componente (abc, abc*, *abc)..." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="12,6"
                                BorderBrush="#E4E7EC"
                                BorderThickness="0,1,0,0"
                                DockPanel.Dock="Bottom">
                                <TextBlock
                                    x:Name="txtEditorCompStatus"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    Text="" />
                            </Border>

                            <DataGrid
                                x:Name="dgComponentiDisp"
                                AutoGenerateColumns="False"
                                Background="White"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                HorizontalGridLinesBrush="#F2F4F7"
                                IsReadOnly="True"
                                MouseDoubleClick="DgComponentiDisp_MouseDoubleClick"
                                PreviewMouseLeftButtonDown="DgComponentiDisp_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="DgComponentiDisp_PreviewMouseMove"
                                RowHeight="28"
                                SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="130"
                                        Binding="{Binding Code}"
                                        FontSize="12"
                                        Header="Codice" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        FontSize="12"
                                        Header="Descrizione" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding Categoria}"
                                        FontSize="11"
                                        Header="Categoria" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--  DX: distinta editabile (drop target)  -->
                <DockPanel Grid.Column="2">
                    <Border
                        Padding="16,12"
                        Background="#F0FFF4"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock
                                x:Name="txtEditorTreeHeader"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#111827"
                                Text="Seleziona un quadro" />
                            <TextBlock
                                x:Name="txtEditorTreeSub"
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="#6B7280"
                                Text="Scegli un quadro a sinistra, poi trascina i componenti nelle sezioni." />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16,8"
                        Background="#F9FAFB"
                        BorderBrush="#E4E7EC"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <DockPanel>
                            <TextBlock
                                x:Name="txtEditorFooterCount"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#6B7280"
                                Text="" />
                            <TextBlock
                                x:Name="txtEditorFooterTotal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#111827"
                                Text="" />
                        </DockPanel>
                    </Border>

                    <TreeView
                        x:Name="treeDistintaEditor"
                        Padding="8"
                        AllowDrop="True"
                        Background="White"
                        BorderThickness="0"
                        DragOver="TreeDistintaEditor_DragOver"
                        Drop="TreeDistintaEditor_Drop"
                        FontSize="13">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="3,1" />
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Page>
