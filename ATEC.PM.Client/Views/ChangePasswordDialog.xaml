<Window
    x:Class="ATEC.PM.Client.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cambia password"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    Background="{DynamicResource ShadcnBackgroundBrush}"
    FontFamily="{DynamicResource ShadcnFontFamily}"
    WindowStartupLocation="CenterOwner">
    <Border Margin="24" Padding="20" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1">
        <StackPanel MinWidth="360">
            <TextBlock
                x:Name="txtTitle"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ShadcnForegroundBrush}"
                Text="Cambia password" />
            <TextBlock
                x:Name="txtSubtitle"
                Margin="0,6,0,16"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                TextWrapping="Wrap" />

            <StackPanel x:Name="panelCurrent">
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                    Text="PASSWORD ATTUALE" />
                <PasswordBox
                    x:Name="txtCurrent"
                    Style="{StaticResource ShadcnPasswordBox}"
                    KeyDown="PasswordBox_KeyDown" />
            </StackPanel>

            <TextBlock
                Margin="0,12,0,4"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="NUOVA PASSWORD" />
            <PasswordBox
                x:Name="txtNew"
                Style="{StaticResource ShadcnPasswordBox}"
                KeyDown="PasswordBox_KeyDown" />

            <TextBlock
                Margin="0,12,0,4"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                Text="CONFERMA NUOVA PASSWORD" />
            <PasswordBox
                x:Name="txtConfirm"
                Style="{StaticResource ShadcnPasswordBox}"
                KeyDown="PasswordBox_KeyDown" />

            <TextBlock
                x:Name="txtError"
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource ShadcnDestructiveBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnCancel"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"
                    Content="Annulla"
                    Style="{StaticResource ShadcnButtonOutline}" />
                <Button
                    x:Name="btnSave"
                    Click="BtnSave_Click"
                    Content="Salva password"
                    Style="{StaticResource ShadcnButtonDefault}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
