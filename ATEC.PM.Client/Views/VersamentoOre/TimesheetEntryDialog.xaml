<Window
    x:Class="ATEC.PM.Client.Views.TimesheetEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Registra Ore"
    Width="420"
    SizeToContent="Height"
    MinHeight="480"
    Background="{DynamicResource ShadcnMutedBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ShadcnFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
            <Style x:Key="ShadcnPasswordBox" TargetType="PasswordBox">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource ShadcnFontFamily}" />
                <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border
            Padding="20,14"
            Background="{DynamicResource ShadcnPrimaryBrush}"
            DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock
                    x:Name="hdrDate"
                    FontFamily="{StaticResource ShadcnFontFamily}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                    Text="" />
                <TextBlock
                    x:Name="hdrSubtitle"
                    Margin="0,2,0,0"
                    FontFamily="{StaticResource ShadcnFontFamily}"
                    FontSize="12"
                    Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                    Opacity="0.85"
                    TextWrapping="Wrap"
                    Text="Registrazione ore" />
            </StackPanel>
        </Border>
        <Border
            Padding="16,12"
            Background="{DynamicResource ShadcnCardBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel LastChildFill="False">
                <!-- Elimina: visibile solo in modifica di una timbratura esistente -->
                <Button
                    x:Name="btnDelete"
                    DockPanel.Dock="Left"
                    Width="90"
                    Click="BtnDelete_Click"
                    Content="Elimina"
                    Foreground="{DynamicResource ShadcnDestructiveBrush}"
                    Style="{StaticResource ShadcnButtonSecondary}"
                    Visibility="Collapsed" />
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="90"
                        Click="BtnCancel_Click"
                        Content="Annulla"
                        Style="{StaticResource ShadcnButtonSecondary}" />
                    <Button
                        x:Name="btnSave"
                        Width="90"
                        Margin="8,0,0,0"
                        Click="BtnSave_Click"
                        Content="Salva"
                        Style="{StaticResource ShadcnButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="24,8,24,16">
            <TextBlock
                x:Name="lblRegistraPer"
                Style="{StaticResource Lbl}"
                Text="REGISTRA PER"
                Visibility="Collapsed" />
            <ComboBox
                x:Name="cmbEmployee"
                Height="34"
                DisplayMemberPath="Name"
                FontSize="13"
                SelectedValuePath="Id"
                SelectionChanged="CmbEmployee_SelectionChanged"
                Visibility="Collapsed" />

            <TextBlock Style="{StaticResource Lbl}" Text="COMMESSA *" />
            <ComboBox
                x:Name="cmbProject"
                Height="34"
                DisplayMemberPath="Display"
                FontSize="13"
                SelectedValuePath="ProjectId"
                SelectionChanged="CmbProject_SelectionChanged" />

            <TextBlock Style="{StaticResource Lbl}" Text="FASE *" />
            <ComboBox
                x:Name="cmbPhase"
                Height="34"
                DisplayMemberPath="Display"
                FontSize="13"
                SelectedValuePath="PhaseId" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="DATA *" />
                    <DatePicker
                        x:Name="dpDate"
                        Height="34"
                        FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="ORE *" />
                    <TextBox
                        x:Name="txtHours"
                        Style="{StaticResource ShadcnTextBox}" />
                </StackPanel>
            </Grid>
            <TextBlock
                x:Name="txtDayHint"
                Margin="0,4,0,0"
                FontFamily="{StaticResource ShadcnFontFamily}"
                FontSize="11"
                Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                TextWrapping="Wrap"
                Text="" />

            <TextBlock Style="{StaticResource Lbl}" Text="TIPO" />
            <ComboBox
                x:Name="cmbType"
                Height="34"
                FontSize="13">
                <ComboBoxItem Content="REGULAR" IsSelected="True" />
                <ComboBoxItem Content="OVERTIME" />
                <ComboBoxItem Content="TRAVEL" />
            </ComboBox>

            <TextBlock Style="{StaticResource Lbl}" Text="NOTE" />
            <TextBox
                x:Name="txtNotes"
                Height="50"
                AcceptsReturn="True"
                Style="{StaticResource ShadcnTextBox}"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="txtError"
                Margin="0,12,0,0"
                FontFamily="{StaticResource ShadcnFontFamily}"
                FontSize="12"
                Foreground="{DynamicResource ShadcnDestructiveBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
