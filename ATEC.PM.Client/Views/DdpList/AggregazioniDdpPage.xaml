<Page
    x:Class="ATEC.PM.Client.Views.AggregazioniDdpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F7F8FA">
    <DockPanel>

        <!--  TOOLBAR  -->
        <Border
            Style="{StaticResource ToolbarBorder}"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1A1D26"
                        Text="Aggregazioni DDP" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#6B7280"
                        Text="Matrice Stati × Aggregazioni — spunta gli stati che compongono ogni aggregazione" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="BtnSave_Click" Content="Salva" Style="{StaticResource PrimaryBtn}" />
                    <Button Click="BtnRefresh_Click" Content="Aggiorna" Style="{StaticResource FlatBtn}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  STATUS BAR  -->
        <Border
            Padding="16,6"
            Background="White"
            BorderBrush="#E4E7EC"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <TextBlock x:Name="txtStatus" FontSize="12" Foreground="#667085" Text="Pronto" />
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Aggregazioni: codice (RO) + nome/descrizione editabili  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#1A1D26" Text="Aggregazioni (nome e descrizione modificabili)" />
                <DataGrid
                    x:Name="dgAgg"
                    MaxHeight="220"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="60" Binding="{Binding Code}" Header="Cod." IsReadOnly="True" />
                        <DataGridTextColumn Width="220" Binding="{Binding Name}" Header="Nome" />
                        <DataGridTextColumn Width="*" MinWidth="260" Binding="{Binding Description}" Header="Descrizione" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!--  Matrice Stati × Aggregazioni (colonne aggiunte in code-behind)  -->
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13" FontWeight="Bold" Foreground="#1A1D26" Text="Matrice — ✓ = lo stato concorre all'aggregazione" />
                <DataGrid
                    x:Name="dgMatrix"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="260" Binding="{Binding Display}" Header="Stato" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Page>
