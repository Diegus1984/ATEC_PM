<Window
    x:Class="ATEC.PM.Client.Views.DdpStatusDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stato DDP"
    Width="440"
    Background="#F7F8FA"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="STATO (chiave — non modificabile)" />
        <TextBlock
            x:Name="txtKey"
            Margin="0,4,0,16"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="#1A1D26" />

        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="ETICHETTA" />
        <TextBox
            x:Name="txtLabel"
            Margin="0,4,0,16"
            Padding="8,6"
            FontSize="14"
            TextChanged="Field_Changed" />

        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="COLORE SFONDO (es. #FF0000)" />
        <DockPanel Margin="0,4,0,4">
            <Border
                x:Name="swBg"
                Width="34"
                Height="28"
                Margin="0,0,8,0"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                DockPanel.Dock="Left" />
            <TextBox
                x:Name="txtBg"
                Padding="8,6"
                FontSize="14"
                TextChanged="Field_Changed" />
        </DockPanel>
        <WrapPanel x:Name="wpBgPresets" Margin="0,0,0,16" />

        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="COLORE TESTO" />
        <DockPanel Margin="0,4,0,4">
            <Border
                x:Name="swFg"
                Width="34"
                Height="28"
                Margin="0,0,8,0"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                DockPanel.Dock="Left" />
            <TextBox
                x:Name="txtFg"
                Padding="8,6"
                FontSize="14"
                TextChanged="Field_Changed" />
        </DockPanel>
        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Click="BtnFgWhite_Click"
                Content="Testo bianco"
                Style="{StaticResource FlatBtn}" />
            <Button
                Click="BtnFgBlack_Click"
                Content="Testo nero"
                Style="{StaticResource FlatBtn}" />
        </StackPanel>

        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="ORDINE" />
        <TextBox
            x:Name="txtOrder"
            Margin="0,4,0,16"
            Padding="8,6"
            FontSize="14"
            Text="0" />

        <CheckBox
            x:Name="chkActive"
            Margin="0,0,0,16"
            Content="Attiva (se disattivata non è più selezionabile nelle nuove righe)"
            FontSize="13"
            IsChecked="True" />

        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#667085"
            Text="ANTEPRIMA" />
        <Border
            x:Name="prevBadge"
            Margin="0,4,0,20"
            Padding="12,6"
            HorizontalAlignment="Left">
            <TextBlock x:Name="prevText" FontWeight="SemiBold" />
        </Border>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Width="100"
                Height="34"
                Margin="0,0,8,0"
                Click="BtnCancel_Click"
                Content="Annulla"
                Style="{StaticResource FlatBtn}" />
            <Button
                Width="100"
                Height="34"
                Background="#4F6EF7"
                Click="BtnSave_Click"
                Content="Salva"
                Foreground="White"
                Style="{StaticResource FlatBtn}" />
        </StackPanel>
    </StackPanel>
</Window>
