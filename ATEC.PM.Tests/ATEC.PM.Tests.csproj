<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ATEC.PM.Tests</RootNamespace>
    <!-- Gli avvisi del progetto Server non sono responsabilità dei test. -->
    <NoWarn>$(NoWarn);CA1416;CS8601;CS8602</NoWarn>
  </PropertyGroup>

  <!-- Xunit disponibile in tutti i file senza ripetere la using. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Tetto al parallelismo (24/08/2026). Senza, xUnit apre una collection per CPU logica —
    su questo PC sono 24 — e ogni collection che tocca il database si crea il suo MySQL
    usa-e-getta: con la macchina occupata da altro il processo host dei test moriva a metà
    corsa ("Arresto anomalo del processo host di test"), lasciando dietro i database di
    prova (ne erano rimasti 71, il più vecchio del 16/08). Con 6 la suite regge; i test
    falliti in quel modo passavano tutti se rilanciati da soli, quindi era contesa, non
    codice rotto. Il file va copiato accanto alla dll, altrimenti il runner non lo legge.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATEC.PM.Server\ATEC.PM.Server.csproj" />
    <ProjectReference Include="..\ATEC.PM.Shared\ATEC.PM.Shared.csproj" />
  </ItemGroup>

</Project>
